// ==UserScript==
// @name         FR Scanner
// @namespace    fr-scanner
// @version      2.0.0
// @description  Scan visible page text for capitalized Candidates and prepare template-specific regexes.
// @match        *://*/*
// @grant        GM_getValue
// @grant        GM_setValue
// @grant        GM_setClipboard
// @grant        GM_registerMenuCommand
// @updateURL    https://github.com/GoroFourArms/Webnovel-Cleaner/raw/refs/heads/main/FR%20Scanner
// @downloadURL  https://github.com/GoroFourArms/Webnovel-Cleaner/raw/refs/heads/main/FR%20Scanner
// @run-at       document-idle
// ==/UserScript==
(() => {
    "use strict";
    const STORE_KEY = "frScanner.settings.v2";
    const PANEL_ID = "fr-scanner-panel";
    const STYLE_ID = "fr-scanner-style";
    const EXCLUDED_TAGS = new Set([
        "SCRIPT",
        "STYLE",
        "NOSCRIPT",
        "TEMPLATE",
        "SVG",
        "CANVAS",
        "IFRAME",
        "NAV",
        "FOOTER",
        "HEADER",
        "ASIDE",
        "BUTTON",
        "INPUT",
        "TEXTAREA",
        "SELECT",
        "OPTION"
    ]);
    const BLOCK_TAGS = new Set([
        "ADDRESS",
        "ARTICLE",
        "BLOCKQUOTE",
        "BR",
        "DD",
        "DIV",
        "DL",
        "DT",
        "FIGCAPTION",
        "FIGURE",
        "H1",
        "H2",
        "H3",
        "H4",
        "H5",
        "H6",
        "LI",
        "MAIN",
        "P",
        "PRE",
        "SECTION",
        "TD",
        "TH",
        "TR"
    ]);
    const TEMPLATES = ["Other", "Korean", "Korean 2", "Japanese"];
    const DEFAULTS = {
        x: 24,
        y: 24,
        width: 980,
        height: 620,
        minimized: false,
        template: "Other",
        singletonCutoff: 0.05,
        showHiddenSingletons: false,
        edits: {},
        columnWidths: {}
    };
    const OCCURRENCE_RE =
        /(?<![A-Z0-9'’.-])((?:(?:Mr|Mrs|Ms|Miss|Dr|Prof|Sr|Jr|St|Rev|Hon|Capt|Col|Gen|Sgt|Lt|Maj)\.[ \t]+)?(?:[A-Z](?:\.[A-Z])+\.\.?|[A-Z]\.|[A-Z]{2,}|[A-Z][A-Za-z0-9'’-]*)(?:\s+(?:[A-Z](?:\.[A-Z])+\.\.?|[A-Z]\.|[A-Z]{2,}|[A-Z][A-Za-z0-9'’-]*))*)(?![A-Za-z0-9'’.-])/g;
    let settings = loadSettings();
    let currentText = "";
    let candidates = [];
    let starts = [];
    let highlightStyle = null;
    let highlightedCandidateId = null;
    let drag = null;
    let resize = null;
    let columnResize = null;
    function loadSettings() {
        try {
            const stored =
                typeof GM_getValue === "function"
                    ? GM_getValue(STORE_KEY, {})
                    : {};
            return {
                ...DEFAULTS,
                ...(stored && typeof stored === "object" ? stored : {}),
                edits: { ...(stored?.edits || {}) },
                columnWidths: { ...(stored?.columnWidths || {}) }
            };
        } catch (_) {
            return { ...DEFAULTS, edits: {}, columnWidths: {} };
        }
    }
    function saveSettings() {
        try {
            if (typeof GM_setValue === "function") {
                GM_setValue(STORE_KEY, settings);
            }
        } catch (_) {}
    }
    function normalizeSpace(s) {
        return String(s ?? "")
            .normalize("NFKC")
            .replace(/[\u2018\u2019]/g, "'")
            .replace(/[\u201C\u201D]/g, '"')
            .replace(/[\u2013\u2014\u2212]/g, "-")
            .replace(/\s+/g, " ")
            .trim();
    }
    function normalizeToken(s) {
        let v = normalizeSpace(s)
            .toLowerCase()
            .replace(/^[\s"'“”‘’([{]+|[\s"'“”‘’)}\]]+$/g, "");
        v = v.replace(/['’]s$/i, "").replace(/s['’]$/, "s");
        if (v.length > 4 && /ies$/.test(v)) v = v.slice(0, -3) + "y";
        else if (v.length > 4 && /(ches|shes|xes|zes)$/.test(v))
            v = v.slice(0, -2);
        else if (v.length > 4 && /ses$/.test(v) && !/sses$/.test(v))
            v = v.slice(0, -2);
        return v;
    }
    function tokens(s) {
        return normalizeSpace(s).split(/\s+/).filter(Boolean);
    }
    function identity(s) {
        return tokens(s).map(normalizeToken).filter(Boolean).join(" ");
    }
    function isExcluded(el) {
        if (!el || el.nodeType !== 1) return false;
        if (EXCLUDED_TAGS.has(el.tagName)) return true;
        if (el.hidden || el.getAttribute("aria-hidden") === "true") return true;
        const style = getComputedStyle(el);
        if (
            style.display === "none" ||
            style.visibility === "hidden" ||
            style.visibility === "collapse" ||
            style.opacity === "0"
        )
            return true;
        const role = (el.getAttribute("role") || "").toLowerCase();
        const cls =
            `${el.id || ""} ${typeof el.className === "string" ? el.className : ""}`.toLowerCase();
        if (
            [
                "navigation",
                "complementary",
                "banner",
                "contentinfo",
                "dialog",
                "alertdialog"
            ].includes(role)
        )
            return true;
        if (
            /(^|\b)(advert|advertisement|ad-container|popup|modal|comment|comments|recommend|related-post|chapter-list|pagination|pager|table-of-contents|toc)(\b|[-_])/i.test(
                cls
            )
        )
            return true;
        return false;
    }
    function extractVisibleText() {
        const page = document.body || document.documentElement;
        if (!page) return "";
        const MIN_TEXT_LENGTH = 300;
        function isUsable(el) {
            if (!el || el.closest("#" + PANEL_ID)) return false;
            if (isExcluded(el)) return false;
            if (!el.getClientRects().length) return false;
            const style = getComputedStyle(el);
            return (
                style.display !== "none" &&
                style.visibility !== "hidden" &&
                style.visibility !== "collapse" &&
                style.opacity !== "0"
            );
        }
        // Find visible text blocks, excluding interface elements.
        const blocks = [
            ...page.querySelectorAll("article, main, section, div")
        ].filter(isUsable);
        const textLength = (el) => {
            const walker = document.createTreeWalker(el, NodeFilter.SHOW_TEXT, {
                acceptNode(node) {
                    const parent = node.parentElement;
                    if (!node.nodeValue?.trim() || !parent) {
                        return NodeFilter.FILTER_REJECT;
                    }
                    let current = parent;
                    while (current && current !== el) {
                        if (
                            isExcluded(current) ||
                            current.closest("#" + PANEL_ID)
                        ) {
                            return NodeFilter.FILTER_REJECT;
                        }
                        current = current.parentElement;
                    }
                    return NodeFilter.FILTER_ACCEPT;
                }
            });
            let total = 0;
            let node;
            while ((node = walker.nextNode())) {
                total += node.nodeValue.trim().length;
            }
            return total;
        };
        const ranked = blocks
            .map((el) => ({ el, length: textLength(el) }))
            .filter((item) => item.length >= MIN_TEXT_LENGTH)
            .sort((a, b) => b.length - a.length);
        if (!ranked.length) return "";
        // Choose the largest text-bearing region that isn't just the whole page.
        const root = ranked.find(
            ({ el }) => el !== document.body && el !== document.documentElement
        )?.el;
        if (!root) return "";
        const pieces = [];
        const walker = document.createTreeWalker(root, NodeFilter.SHOW_TEXT, {
            acceptNode(node) {
                const el = node.parentElement;
                if (!node.nodeValue?.trim() || !el || !isUsable(el)) {
                    return NodeFilter.FILTER_REJECT;
                }
                let current = el;
                while (current && current !== root) {
                    if (
                        isExcluded(current) ||
                        current.closest("#" + PANEL_ID)
                    ) {
                        return NodeFilter.FILTER_REJECT;
                    }
                    current = current.parentElement;
                }
                return NodeFilter.FILTER_ACCEPT;
            }
        });
        let node;
        while ((node = walker.nextNode())) {
            const text = node.nodeValue
                .replace(/[\u200B-\u200D\uFEFF\u00AD]/g, " ")
                .replace(/\s+/g, " ")
                .trim();
            if (text) {
                const parentBlock = node.parentElement?.closest(
                    [...BLOCK_TAGS].join(",")
                );
                pieces.push({
                    text,
                    block: parentBlock
                });
            }
        }
        let result = "";
        let previousBlock = null;
        for (const piece of pieces) {
            if (result) {
                result +=
                    piece.block && piece.block !== previousBlock ? "\n" : " ";
            }
            result += piece.text;
            previousBlock = piece.block;
        }
        return result.trim();
    }
    function findSentenceStarts(text) {
        const starts = new Set();
        for (let i = 0; i < text.length; i++) {
            if (text[i] === "\n") {
                let next = i + 1;
                while (next < text.length && /\s/.test(text[next])) next++;
                while (next < text.length && /["'“”‘’([{]/.test(text[next]))
                    next++;
                if (next < text.length) starts.add(next);
            }
        }
        let first = 0;
        // Find the first non-whitespace character, skipping opening quotes/brackets.
        while (
            first < text.length &&
            (/\s/.test(text[first]) || /["'“”‘’([{]/.test(text[first]))
        ) {
            first++;
        }
        if (first < text.length) starts.add(first);
        // Recognized titles whose periods must not end a sentence.
        const titlePattern =
            /\b(?:Mr|Mrs|Ms|Miss|Dr|Prof|Sr|Jr|St|Rev|Hon|Capt|Col|Gen|Sgt|Lt|Maj)\./gi;
        const titlePeriods = new Set();
        for (const match of text.matchAll(titlePattern)) {
            titlePeriods.add(match.index + match[0].length - 1);
        }
        for (let i = 0; i < text.length; i++) {
            const ch = text[i];
            if (ch === ".") {
                if (titlePeriods.has(i)) continue;
                // A period after a single capital letter is an initial.
                if (
                    i > 0 &&
                    /[A-Z]/.test(text[i - 1]) &&
                    (i < 2 || !/[A-Za-z]/.test(text[i - 2]))
                ) {
                    continue;
                }
            } else if (ch !== "!" && ch !== "?") {
                continue;
            }
            // Consume consecutive sentence-ending punctuation.
            let next = i + 1;
            while (next < text.length && /[.!?]/.test(text[next])) {
                next++;
            }
            // Skip closing quotes/brackets after the punctuation.
            while (next < text.length && /["'”’)\]}]/.test(text[next])) {
                next++;
            }
            // Skip whitespace and opening quotes/brackets before the next sentence.
            while (
                next < text.length &&
                (/\s/.test(text[next]) || /["'“”‘’([{]/.test(text[next]))
            ) {
                next++;
            }
            if (next < text.length) starts.add(next);
            i = next - 1;
        }
        return starts;
    }
    function isSentenceStart(text, index, sentenceStarts) {
        // Allow whitespace and opening quotes/brackets before the occurrence.
        let i = index;
        while (
            i < text.length &&
            (/\s/.test(text[i]) || /["'“”‘’([{]/.test(text[i]))
        ) {
            i++;
        }
        return sentenceStarts.has(i);
    }
    function collect(records, kind) {
        const map = new Map();
        for (const occ of records) {
            const display = normalizeSpace(occ.text).replace(/['’]s$/i, ""),
                key = identity(display);
            if (!key) continue;
            let item = map.get(key);
            if (!item) {
                item = {
                    id: `${kind}-${map.size}-${key}`,
                    name: display,
                    normalized: key,
                    occurrenceCount: 0,
                    frequency: 0,
                    originalIndex: occ.start,
                    occurrences: [],
                    prefixes: new Map(),
                    suffixes: new Map(),
                    edit: settings.edits[key] ?? display,
                    assignedStarts: [],
                    clusterSeed: null
                };
                map.set(key, item);
            }
            item.occurrenceCount++;
            item.frequency++;
            item.occurrences.push(occ);
            if (display.length < item.name.length) item.name = display;
        }
        return [...map.values()];
    }
    function findOccurrenceSpans(text) {
        const occurrences = [];
        const sentenceStarts = findSentenceStarts(text);
        const re = new RegExp(OCCURRENCE_RE.source, OCCURRENCE_RE.flags);
        let m;
        while ((m = re.exec(text)) !== null) {
            const phrase = m[1];
            const start = m.index + m[0].indexOf(phrase);
            const end = start + phrase.length;
            occurrences.push({
                text: phrase,
                normalized: identity(phrase),
                start,
                end,
                isStart: isSentenceStart(text, start, sentenceStarts)
            });
            if (m[0].length === 0) re.lastIndex++;
        }
        return occurrences;
    }
    function classifyOccurrences(text) {
        const occurrences = findOccurrenceSpans(text);
        return {
            candidates: occurrences.filter((occurrence) => !occurrence.isStart),
            starts: occurrences.filter((occurrence) => occurrence.isStart)
        };
    }
    function passTwoCandidate(start, list) {
        const startTokens = tokens(start.name ?? start.text)
            .map(normalizeToken)
            .filter(Boolean);
        const matches = [];
        list.forEach((candidate, originalIndex) => {
            const candidateTokens = tokens(candidate.name)
                .map(normalizeToken)
                .filter(Boolean);
            if (
                !candidateTokens.length ||
                candidateTokens.length > startTokens.length
            ) {
                return;
            }
            // Find contiguous Candidate-token sequences within the Start.
            const alignments = [];
            for (
                let i = 0;
                i <= startTokens.length - candidateTokens.length;
                i++
            ) {
                const matched = candidateTokens.every(
                    (token, j) => token === startTokens[i + j]
                );
                if (matched) {
                    alignments.push(candidateTokens.map((_, j) => [j, i + j]));
                }
            }
            if (!alignments.length) return;
            // Prefer the alignment furthest to the right.
            alignments.sort((a, b) => {
                for (let i = a.length - 1; i >= 0; i--) {
                    if (a[i][1] !== b[i][1]) {
                        return b[i][1] - a[i][1];
                    }
                }
                return 0;
            });
            const alignment = alignments[0];
            const exact =
                candidateTokens.length === startTokens.length &&
                candidateTokens.every((token, i) => token === startTokens[i]);
            matches.push({
                candidate,
                alignment,
                exact,
                matched: candidateTokens.length,
                totalTokens: candidateTokens.length,
                originalIndex
            });
        });
        // Pipeline priority:
        // 1. Exact normalized match
        // 2. Most matching tokens
        // 3. Fewest total tokens in Candidate
        // 4. Tokens furthest right, comparing right to left
        // 5. First Candidate in original order
        matches.sort((a, b) => {
            if (a.exact !== b.exact) {
                return Number(b.exact) - Number(a.exact);
            }
            if (a.matched !== b.matched) {
                return b.matched - a.matched;
            }
            if (a.totalTokens !== b.totalTokens) {
                return a.totalTokens - b.totalTokens;
            }
            for (
                let i = Math.min(a.alignment.length, b.alignment.length) - 1;
                i >= 0;
                i--
            ) {
                const aStartIndex = a.alignment[i][1];
                const bStartIndex = b.alignment[i][1];
                if (aStartIndex !== bStartIndex) {
                    return bStartIndex - aStartIndex;
                }
            }
            return a.originalIndex - b.originalIndex;
        });
        return matches.length ? matches[0] : null;
    }
    function selectedSpan(start, alignment) {
        if (!alignment?.length) return null;
        const sourceTokens = [];
        const source = start.text;
        const re = /\S+/g;
        let match;
        while ((match = re.exec(source)) !== null) {
            const value = normalizeToken(match[0]);
            if (!value) continue;
            sourceTokens.push({
                value,
                start: match.index,
                end: match.index + match[0].length
            });
        }
        // Pass Two alignment pairs are [candidateTokenIndex, startTokenIndex].
        const sourceIndexes = alignment.map((pair) => pair[1]);
        if (
            sourceIndexes.some(
                (index) =>
                    !Number.isInteger(index) ||
                    index < 0 ||
                    index >= sourceTokens.length
            )
        ) {
            return null;
        }
        const first = Math.min(...sourceIndexes);
        const last = Math.max(...sourceIndexes);
        return {
            start: sourceTokens[first].start,
            end: sourceTokens[last].end
        };
    }
    function affixesFor(occurrence, alignment) {
        const span = selectedSpan(occurrence, alignment);
        if (!span) {
            return { prefix: "", suffix: "" };
        }
        const clean = (value) => value.replace(/[\p{P}\p{S}\s]+/gu, " ").trim();
        return {
            prefix: clean(occurrence.text.slice(0, span.start)),
            suffix: clean(occurrence.text.slice(span.end))
        };
    }
    function addAffix(map, value) {
        if (!value) return;
        map.set(value, (map.get(value) || 0) + 1);
    }
    function findExactCandidate(start, candidates) {
        return (
            candidates.find(
                (candidate) => candidate.normalized === start.normalized
            ) || null
        );
    }
    function analyze(text) {
        const classified = classifyOccurrences(text);
        const candidateOccurrences = classified.candidates;
        const startOccurrences = classified.starts;
        const list = collect(candidateOccurrences, "c");
        const startList = collect(startOccurrences, "s");
        // Pass One: exact full normalized identity.
        for (const s of startList) {
            const c = findExactCandidate(s, list);
            if (!c) continue;
            c.frequency += s.occurrenceCount;
            c.assignedStarts.push({ start: s, pass: 1 });
            s.matchedCandidate = c;
            s.matchPass = 1;
            // Pass One matches contribute affixes too.
            for (const occ of s.occurrences) {
                const alignment = tokens(c.name)
                    .map(normalizeToken)
                    .filter(Boolean)
                    .map((_, index) => [index, index]);
                const affix = affixesFor(occ, alignment);
                addAffix(c.prefixes, affix.prefix);
                addAffix(c.suffixes, affix.suffix);
            }
        }
        // Pass Two: remaining Starts. Every Start can be assigned at most once.
        for (const s of startList) {
            if (s.matchedCandidate) continue;
            const match = passTwoCandidate(s, list);
            if (!match) continue;
            const c = match.candidate;
            c.frequency += s.occurrenceCount;
            c.assignedStarts.push({ start: s, pass: 2 });
            s.matchedCandidate = c;
            s.matchPass = 2;
            for (const occ of s.occurrences) {
                const affix = affixesFor(occ, match.alignment);
                addAffix(c.prefixes, affix.prefix);
                addAffix(c.suffixes, affix.suffix);
            }
        }
        buildClusters(list);
        return {
            candidates: list,
            starts: startList,
            scanned: candidateOccurrences.length + startOccurrences.length
        };
    }
    function sharedToken(a, b) {
        const aa = new Set(tokens(a).map(normalizeToken));
        return tokens(b)
            .map(normalizeToken)
            .some((t) => aa.has(t));
    }
    function buildClusters(list) {
        const ordered = [...list].sort(
            (a, b) =>
                b.frequency - a.frequency || a.originalIndex - b.originalIndex
        );
        for (const candidate of ordered) {
            candidate.clusterSeed = null;
        }
        const claimed = new Set();
        const result = [];
        for (const seed of ordered) {
            if (claimed.has(seed)) continue;
            // Keep the seed first.
            result.push(seed);
            claimed.add(seed);
            // Degree 1: direct matches to the seed.
            const direct = ordered.filter(
                (candidate) =>
                    !claimed.has(candidate) &&
                    sharedToken(seed.name, candidate.name)
            );
            if (direct.length === 0) {
                seed.clusterSeed = null;
                continue;
            }
            seed.clusterSeed = seed;
            for (const member of direct) {
                member.clusterSeed = seed;
                claimed.add(member);
                result.push(member);
            }
            // Degree 2: one bridge pass through degree-1 members only.
            for (const bridge of direct) {
                for (const candidate of ordered) {
                    if (claimed.has(candidate)) continue;
                    if (sharedToken(bridge.name, candidate.name)) {
                        candidate.clusterSeed = seed;
                        claimed.add(candidate);
                        result.push(candidate);
                    }
                }
            }
        }
        list.splice(0, list.length, ...result);
    }
    function escapeRegex(s) {
        return String(s).replace(/[.*+?^${}()|[\]\\]/g, "\\$&");
    }
    function generateRegex(candidate, template) {
        const value = String(candidate ?? "").trim();
        if (!value) return "";
        const parts = value.split(/\s+/).filter(Boolean);
        let source = "";
        if (template === "Japanese") {
            const rightTwo = parts.slice(-2).map(escapeRegex);
            if (rightTwo.length === 2) {
                source = `${rightTwo[0]}\\s*${rightTwo[1]}|${rightTwo[1]}\\s*${rightTwo[0]}`;
            } else {
                source = escapeRegex(value);
            }
        } else {
            source = escapeRegex(value);
            if (template === "Korean") {
                source = source.replace(/-/g, "[ -]?").replace(/\s+/g, "[ -]?");
            } else if (template === "Korean 2") {
                source = source.replace(/-/g, "[- ]?").replace(/\s+/g, "[- ]+");
                // Make the second token from the right optional.
                if (parts.length >= 2) {
                    const last = escapeRegex(parts.at(-1));
                    const optional = escapeRegex(parts.at(-2));
                    const prefix = parts
                        .slice(0, -2)
                        .map(escapeRegex)
                        .join("[- ]+");
                    source = prefix
                        ? `${prefix}[- ]+(?:${optional}[- ]+)?${last}`
                        : `(?:${optional}[- ]+)?${last}`;
                }
            }
        }
        return `(?<![a-z])(?:${source})(?![a-z])`;
    }
    function displayAffixes(map) {
        if (!map.size) return "—";
        return [...map.entries()]
            .sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]))
            .map(([v, n]) => `${v} (${n})`)
            .join(", ");
    }
    function esc(s) {
        return String(s ?? "").replace(
            /[&<>"']/g,
            (c) =>
                ({
                    "&": "&amp;",
                    "<": "&lt;",
                    ">": "&gt;",
                    '"': "&quot;",
                    "'": "&#39;"
                })[c]
        );
    }
    function ensureStyle() {
        if (document.getElementById(STYLE_ID)) return;
        const style = document.createElement("style");
        style.id = STYLE_ID;
        style.textContent = `
        #${PANEL_ID} {
            position: fixed;
            z-index: 2147483646;
            background: #17191d;
            color: #f2f3f5;
            border: 1px solid #555;
            border-radius: 8px;
            box-shadow: 0 8px 32px #0008;
            font: 13px/1.4 system-ui, sans-serif;
            display: flex;
            flex-direction: column;
            overflow: hidden;
        }
        #${PANEL_ID} * {
            box-sizing: border-box;
        }
        #${PANEL_ID} .fr-head {
            display: flex;
            align-items: center;
            gap: 8px;
            padding: 8px 10px;
            background: #24272d;
            cursor: move;
            user-select: none;
        }
        #${PANEL_ID} .fr-head strong {
            font-size: 14px;
        }
        #${PANEL_ID} button,
        #${PANEL_ID} select {
            background: #343840;
            color: #f2f3f5;
            border: 1px solid #555;
            border-radius: 4px;
            padding: 4px 7px;
            cursor: pointer;
        }
        #${PANEL_ID} button:hover {
            background: #454a54;
        }
        #${PANEL_ID} .fr-toolbar {
            display: flex;
