// ==UserScript==
// @name         FR Scanner
// @namespace    fr-scanner
// @version      2.0.0
// @description  Scan visible page text for capitalized Candidates and prepare template-specific regexes.
// @match        *://*/*
// @grant        GM_getValue
// @grant        GM_setValue
// @grant        GM_setClipboard
// @grant        GM_registerMenuCommand
// @run-at       document-idle
// ==/UserScript==
(() => {
    "use strict";
    const STORE_KEY = "frScanner.settings.v2";
    const PANEL_ID = "fr-scanner-panel";
    const STYLE_ID = "fr-scanner-style";
    const EXCLUDED_TAGS = new Set([
        "SCRIPT",
        "STYLE",
        "NOSCRIPT",
        "TEMPLATE",
        "SVG",
        "CANVAS",
        "IFRAME",
        "NAV",
        "FOOTER",
        "HEADER",
        "ASIDE",
        "BUTTON",
        "INPUT",
        "TEXTAREA",
        "SELECT",
        "OPTION"
    ]);
    const BLOCK_TAGS = new Set([
        "ADDRESS",
        "ARTICLE",
        "BLOCKQUOTE",
        "BR",
        "DD",
        "DIV",
        "DL",
        "DT",
        "FIGCAPTION",
        "FIGURE",
        "H1",
        "H2",
        "H3",
        "H4",
        "H5",
        "H6",
        "LI",
        "MAIN",
        "P",
        "PRE",
        "SECTION",
        "TD",
        "TH",
        "TR"
    ]);
    const TEMPLATES = ["Other", "Korean", "Korean 2", "Japanese"];
    const DEFAULTS = {
        x: 24,
        y: 24,
        width: 980,
        height: 620,
        minimized: false,
        template: "Other",
        singletonCutoff: 0.05,
        showHiddenSingletons: false,
        edits: {},
        columnWidths: {}
    };
    let settings = loadSettings();
    let currentText = "";
    let candidates = [];
    let starts = [];
    let highlightStyle = null;
    let highlightedCandidateId = null;
    let drag = null;
    let resize = null;
    let renderQueued = false;
    function loadSettings() {
        try {
            const stored =
                typeof GM_getValue === "function"
                    ? GM_getValue(STORE_KEY, {})
                    : {};
            return {
                ...DEFAULTS,
                ...(stored && typeof stored === "object" ? stored : {}),
                edits: { ...(stored?.edits || {}) },
                columnWidths: { ...(stored?.columnWidths || {}) }
            };
        } catch (_) {
            return { ...DEFAULTS, edits: {}, columnWidths: {} };
        }
    }
    function saveSettings() {
        try {
            if (typeof GM_setValue === "function")
                GM_setValue(STORE_KEY, settings);
        } catch (_) {
            showStatus(
                "Could not save settings; current session will continue.",
                true
            );
        }
    }
    function normalizeSpace(s) {
        return String(s ?? "")
            .normalize("NFKC")
            .replace(/[\u2018\u2019]/g, "'")
            .replace(/[\u201C\u201D]/g, '"')
            .replace(/[\u2013\u2014\u2212]/g, "-")
            .replace(/\s+/g, " ")
            .trim();
    }
    function normalizeToken(s) {
        let v = normalizeSpace(s)
            .toLowerCase()
            .replace(/^[\s"'“”‘’([{]+|[\s"'“”‘’)}\]]+$/g, "");
        v = v.replace(/['’]s$/i, "").replace(/s['’]$/, "s");
        if (v.length > 4 && /ies$/.test(v)) v = v.slice(0, -3) + "y";
        else if (v.length > 4 && /(ches|shes|xes|zes)$/.test(v))
            v = v.slice(0, -2);
        else if (v.length > 4 && /ses$/.test(v) && !/sses$/.test(v))
            v = v.slice(0, -2);
        return v;
    }
    function tokens(s) {
        return normalizeSpace(s).split(/\s+/).filter(Boolean);
    }
    function identity(s) {
        return tokens(s).map(normalizeToken).filter(Boolean).join(" ");
    }
    function isExcluded(el) {
        if (!el || el.nodeType !== 1) return false;
        if (EXCLUDED_TAGS.has(el.tagName)) return true;
        if (el.hidden || el.getAttribute("aria-hidden") === "true") return true;
        const style = getComputedStyle(el);
        if (
            style.display === "none" ||
            style.visibility === "hidden" ||
            style.visibility === "collapse" ||
            style.opacity === "0"
        )
            return true;
        const role = (el.getAttribute("role") || "").toLowerCase();
        const cls =
            `${el.id || ""} ${typeof el.className === "string" ? el.className : ""}`.toLowerCase();
        if (
            [
                "navigation",
                "complementary",
                "banner",
                "contentinfo",
                "dialog",
                "alertdialog"
            ].includes(role)
        )
            return true;
        if (
            /(^|\b)(advert|advertisement|ad-container|popup|modal|comment|comments|recommend|related-post|chapter-list|pagination|pager|table-of-contents|toc)(\b|[-_])/i.test(
                cls
            )
        )
            return true;
        return false;
    }
    function extractVisibleText() {
        const pieces = [];
        const walker = document.createTreeWalker(
            document.body || document.documentElement,
            NodeFilter.SHOW_TEXT,
            {
                acceptNode(node) {
                    if (!node.nodeValue || !node.nodeValue.trim())
                        return NodeFilter.FILTER_REJECT;
                    let el = node.parentElement;
                    while (el && el !== document.body) {
                        if (isExcluded(el)) return NodeFilter.FILTER_REJECT;
                        el = el.parentElement;
                    }
                    if (el && isExcluded(el)) return NodeFilter.FILTER_REJECT;
                    return NodeFilter.FILTER_ACCEPT;
                }
            }
        );
        let n;
        while ((n = walker.nextNode())) {
            const text = n.nodeValue.replace(/\s+/g, " ").trim();
            if (!text) continue;
            pieces.push(text);
            let p = n.parentElement;
            while (p && p !== document.body) {
                if (BLOCK_TAGS.has(p.tagName)) {
                    pieces.push("\n");
                    break;
                }
                p = p.parentElement;
            }
        }
        return pieces
            .join(" ")
            .replace(/\s*\n\s*/g, "\n")
            .replace(/[ \t]+/g, " ")
            .trim();
    }
    // One occurrence is one regex match. Sentence position determines Start vs Candidate.
    const OCCURRENCE_RE =
        /(?<![A-Z0-9'’.-])(?:[A-Z](?:\.[A-Z])+\.\.?|[A-Z]\.|[A-Z]{2,}|[A-Z][A-Za-z0-9'’.-]*)(?:[ \t]+(?:[A-Z](?:\.[A-Z])+\.\.?|[A-Z]\.|[A-Z]{2,}|[A-Z][A-Za-z0-9'’.-]*))*(?![A-Za-z0-9'’.-])/g;
    function isSentenceStart(text, index) {
        for (let i = index - 1; i >= 0; i--) {
            const c = text[i];
            if (/\s/.test(c) || /["'“”‘’([{]/.test(c)) continue;
            return /[.!?]/.test(c);
        }
        return index === 0;
    }
    function scanOccurrences(text) {
        const foundCandidates = [],
            foundStarts = [];
        OCCURRENCE_RE.lastIndex = 0;
        let m;
        while ((m = OCCURRENCE_RE.exec(text))) {
            const value = normalizeSpace(m[1]);
            if (!value) continue;
            const occ = {
                text: value,
                index: m.index + m[0].indexOf(m[1]),
                end: m.index + m[0].indexOf(m[1]) + m[1].length
            };
            // Avoid treating a single-token prefix of a longer capitalized phrase as an extra match.
            const previous = foundCandidates
                .concat(foundStarts)
                .sort((a, b) => a.index - b.index)
                .at(-1);
            if (
                previous &&
                occ.index >= previous.index &&
                occ.index < previous.end
            )
                continue;
            if (isSentenceStart(text, occ.index)) foundStarts.push(occ);
            else foundCandidates.push(occ);
            if (m[0].length === 0) OCCURRENCE_RE.lastIndex++;
        }
        return { foundCandidates, foundStarts };
    }
    function collect(records, kind) {
        const map = new Map();
        for (const occ of records) {
            const display = normalizeSpace(occ.text),
                key = identity(display);
            if (!key) continue;
            let item = map.get(key);
            if (!item) {
                item = {
                    id: `${kind}-${map.size}-${key}`,
                    name: display,
                    normalized: key,
                    occurrenceCount: 0,
                    frequency: 0,
                    originalIndex: occ.index,
                    occurrences: [],
                    prefixes: new Map(),
                    suffixes: new Map(),
                    edit: settings.edits[key] ?? display,
                    assignedStarts: [],
                    clusterSeed: null
                };
                map.set(key, item);
            }
            item.occurrenceCount++;
            item.frequency++;
            item.occurrences.push(occ);
            if (display.length < item.name.length) item.name = display;
        }
        return [...map.values()];
    }
    function findExactCandidate(start, list) {
        const key = identity(start.text);
        return list.find((c) => c.normalized === key) || null;
    }
    function tokenMatch(a, b) {
        const aa = tokens(a).map(normalizeToken).filter(Boolean),
            bb = tokens(b).map(normalizeToken).filter(Boolean);
        let matches = 0;
        const used = new Set();
        for (const t of aa) {
            const j = bb.findIndex((v, i) => v === t && !used.has(i));
            if (j >= 0) {
                used.add(j);
                matches++;
            }
        }
        return {
            matches,
            total: aa.length + bb.length,
            congruity: aa.length > 0 && bb.length > 0 && aa[0] === bb[0] ? 1 : 0
        };
    }
    function passTwoCandidate(start, list) {
        const st = tokens(start.text).map(normalizeToken).filter(Boolean);
        let choices = [];
        for (const c of list) {
            const ct = tokens(c.name).map(normalizeToken).filter(Boolean);
            if (!ct.length || !st.length) continue;
            const candidateTokens = new Set(ct);
            const startTokens = new Set(st);
            const shared = [...candidateTokens].filter((t) =>
                startTokens.has(t)
            ).length;
            if (!shared) continue;
            // Rank by requested order: most matching tokens, least total tokens, congruity, right-to-left.
            const total = ct.length + st.length;
            const congruity = ct[ct.length - 1] === st[st.length - 1] ? 1 : 0;
            const rightmost = Math.max(
                ...ct.map((t) => st.lastIndexOf(t)).filter((i) => i >= 0)
            );
            choices.push({ c, shared, total, congruity, rightmost });
        }
        choices.sort(
            (a, b) =>
                b.shared - a.shared ||
                a.total - b.total ||
                b.congruity - a.congruity ||
                b.rightmost - a.rightmost ||
                a.c.originalIndex - b.c.originalIndex
        );
        return choices[0]?.c || null;
    }
    function selectedSpan(start, candidate) {
        const source = start.text;
        const sourceRegex = /[\p{L}\p{M}\p{N}]+(?:['’.-][\p{L}\p{M}\p{N}]+)*/gu;
        const sourceTokens = [];
        let match;
        while ((match = sourceRegex.exec(source)) !== null) {
            sourceTokens.push({
                value: normalizeToken(match[0]),
                start: match.index,
                end: match.index + match[0].length
            });
        }
        const candidateTokens = tokens(candidate.name)
            .map(normalizeToken)
            .filter(Boolean);
        let best = null;
        for (let i = 0; i < sourceTokens.length; i++) {
            for (let j = 0; j < candidateTokens.length; j++) {
                if (sourceTokens[i].value !== candidateTokens[j]) continue;
                let length = 0;
                while (
                    i + length < sourceTokens.length &&
                    j + length < candidateTokens.length &&
                    sourceTokens[i + length].value ===
                        candidateTokens[j + length]
                ) {
                    length++;
                }
                const result = {
                    start: sourceTokens[i].start,
                    end: sourceTokens[i + length - 1].end,
                    length
                };
                if (!best || result.length > best.length) {
                    best = result;
                }
            }
        }
        return best;
    }
    function affixesFor(occurrence, candidate) {
        const span = selectedSpan(occurrence, candidate);
        if (!span) {
            return { prefix: "", suffix: "" };
        }
        const clean = (value) => value.replace(/[\p{P}\p{S}\s]+/gu, " ").trim();
        return {
            prefix: clean(occurrence.text.slice(0, span.start)),
            suffix: clean(occurrence.text.slice(span.end))
        };
    }
    function addAffix(map, value) {
        if (!value) return;
        map.set(value, (map.get(value) || 0) + 1);
    }
    function analyze(text) {
        const scanned = scanOccurrences(text);
        const list = collect(scanned.foundCandidates, "c");
        const startList = collect(scanned.foundStarts, "s");
        // Pass One: exact full normalized identity.
        for (const s of startList) {
            const c = findExactCandidate(s, list);
            if (!c) continue;
            c.frequency += s.occurrenceCount;
            c.assignedStarts.push({ start: s, pass: 1 });
            s.matchedCandidate = c;
            s.matchPass = 1;
        }
        // Pass Two: remaining Starts. Every Start can be assigned at most once.
        for (const s of startList) {
            if (s.matchedCandidate) continue;
            const c = passTwoCandidate(s, list);
            if (!c) continue;
            c.frequency += s.occurrenceCount;
            c.assignedStarts.push({ start: s, pass: 2 });
            s.matchedCandidate = c;
            s.matchPass = 2;
            for (const occ of s.occurrences) {
                const affix = affixesFor(occ, c);
                addAffix(c.prefixes, affix.prefix);
                addAffix(c.suffixes, affix.suffix);
            }
        }
        list.sort(
            (a, b) =>
                b.frequency - a.frequency || a.originalIndex - b.originalIndex
        );
        buildClusters(list);
        return {
            candidates: list,
            starts: startList,
            scanned: scanned.foundCandidates.length + scanned.foundStarts.length
        };
    }
    function sharedToken(a, b) {
        const aa = new Set(tokens(a).map(normalizeToken));
        return tokens(b)
            .map(normalizeToken)
            .some((t) => aa.has(t));
    }
    function buildClusters(list) {
        // One bridge level only: seed -> direct members -> one bridge-linked member; no further expansion.
        const claimed = new Set();
        for (const seed of list) {
            if (claimed.has(seed)) continue;
            const direct = list.filter(
                (c) =>
                    c !== seed &&
                    !claimed.has(c) &&
                    sharedToken(seed.name, c.name)
            );
            if (!direct.length) {
                seed.clusterSeed = null;
                continue;
            }
            seed.clusterSeed = seed;
            claimed.add(seed);
            for (const member of direct) {
                member.clusterSeed = seed;
                claimed.add(member);
            }
            for (const bridge of direct) {
                for (const member of list) {
                    if (member === seed || claimed.has(member)) continue;
                    if (sharedToken(bridge.name, member.name)) {
                        member.clusterSeed = seed;
                        claimed.add(member);
                    }
                }
            }
        }
    }
    function escapeRegex(s) {
        return String(s).replace(/[.*+?^${}()|[\]\\]/g, "\\$&");
    }
    function generateRegex(candidate, template) {
        const value = normalizeSpace(candidate);
        if (!value) return "";
        let source = escapeRegex(value);
        if (template === "Korean") {
            // Treat hyphens as an optional separator: hyphen, space, or nothing.
            source = source.replace(/-/g, "[ -]?").replace(/\s+/g, "[ -]?");
        } else if (template === "Korean 2") {
            source = source.replace(/-/g, "[- ]?").replace(/\s+/g, "[- ]+");
        } else if (template === "Japanese") {
            source = source.replace(/\s+/g, "\\s*");
        }
        return source;
    }
    function displayAffixes(map) {
        if (!map.size) return "—";
        return [...map.entries()]
            .sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]))
            .map(([v, n]) => `${v} (${n})`)
            .join(", ");
    }
    function esc(s) {
        return String(s ?? "").replace(
            /[&<>"']/g,
            (c) =>
                ({
                    "&": "&amp;",
                    "<": "&lt;",
                    ">": "&gt;",
                    '"': "&quot;",
                    "'": "&#39;"
                })[c]
        );
    }
    function ensureStyle() {
        if (document.getElementById(STYLE_ID)) return;
        const style = document.createElement("style");
        style.id = STYLE_ID;
        style.textContent = `#${PANEL_ID}{position:fixed;z-index:2147483646;background:#17191d;color:#f2f3f5;border:1px solid #555;border-radius:8px;box-shadow:0 8px 32px #0008;font:13px/1.4 system-ui,sans-serif;display:flex;flex-direction:column;overflow:hidden}#${PANEL_ID} *{box-sizing:border-box}#${PANEL_ID} .fr-head{display:flex;align-items:center;gap:8px;padding:8px 10px;background:#24272d;cursor:move;user-select:none}#${PANEL_ID} .fr-head strong{font-size:14px}#${PANEL_ID} button,#${PANEL_ID} select{background:#343840;color:#f2f3f5;border:1px solid #555;border-radius:4px;padding:4px 7px;cursor:pointer}#${PANEL_ID} button:hover{background:#454a54}#${PANEL_ID} .fr-toolbar{display:flex;flex-wrap:wrap;gap:6px;padding:8px;border-bottom:1px solid #45484e}#${PANEL_ID} .fr-status{padding:5px 9px;color:#c7ccd4}#${PANEL_ID} .fr-status.error{color:#ff9999}#${PANEL_ID} .fr-tablewrap{overflow:auto;flex:1;min-height:0}#${PANEL_ID} table{border-collapse:collapse;width:100%;table-layout:fixed}#${PANEL_ID} th,#${PANEL_ID} td{border-bottom:1px solid #363940;padding:6px;text-align:left;vertical-align:top;overflow-wrap:anywhere}#${PANEL_ID} th{position:sticky;top:0;background:#25282e;z-index:1}#${PANEL_ID} td input{width:100%;min-width:80px;background:#101216;color:#fff;border:1px solid #555;border-radius:3px;padding:5px}#${PANEL_ID} .fr-regex{font:12px/1.35 ui-monospace,monospace;white-space:pre-wrap;word-break:break-all}#${PANEL_ID} .fr-small{font-size:11px;color:#bdc2ca}#${PANEL_ID} .fr-resize{height:7px;cursor:ns-resize;background:#292c32}#${PANEL_ID} .fr-colresize{display:inline-block;float:right;width:5px;height:20px;cursor:col-resize}#${PANEL_ID} .fr-foot{padding:6px 9px;color:#aeb4be;border-top:1px solid #444;font-size:11px}#${PANEL_ID} .fr-hidden{display:none!important}`;
        document.head.appendChild(style);
    }
    function createPanel() {
        if (document.getElementById(PANEL_ID)) return;
        ensureStyle();
        const panel = document.createElement("section");
        panel.id = PANEL_ID;
        panel.style.left = `${Math.max(0, settings.x)}px`;
        panel.style.top = `${Math.max(0, settings.y)}px`;
        panel.style.width = `${Math.max(520, settings.width)}px`;
        panel.style.height = `${Math.max(260, settings.height)}px`;
        panel.innerHTML = `<div class="fr-head"><strong>FR Scanner</strong><span id="fr-count" class="fr-small"></span><span style="flex:1"></span><button id="fr-rescan">Rescan</button><button id="fr-min">${settings.minimized ? "Restore" : "Minimize"}</button><button id="fr-close" title="Close panel">×</button></div><div class="fr-toolbar" id="fr-toolbar"><label>Template <select id="fr-template">${TEMPLATES.map((t) => `<option>${esc(t)}</option>`).join("")}</select></label><button id="fr-copy-all">Copy all regexes</button><label><input type="checkbox" id="fr-show-singletons" style="vertical-align:middle"> Show hidden singletons</label></div><div id="fr-status" class="fr-status">Scanning visible page text…</div><div class="fr-tablewrap" id="fr-tablewrap"><table><thead><tr><th data-col="candidate">Candidate</th><th data-col="prefix">Prefix</th><th data-col="suffix">Suffix</th><th data-col="frequency">Frequency</th><th data-col="regex">Generated regex</th><th>Actions</th></tr></thead><tbody id="fr-rows"></tbody></table></div><div class="fr-foot">Candidate edits affect regex generation only; analysis results remain unchanged.</div><div class="fr-resize" title="Resize panel"></div>`;
        document.body.appendChild(panel);
        panel.querySelector("#fr-template").value = settings.template;
        panel.querySelector("#fr-show-singletons").checked =
            !!settings.showHiddenSingletons;
        panel.querySelector("#fr-rescan").addEventListener("click", runScan);
        panel.querySelector("#fr-min").addEventListener("click", () => {
            settings.minimized = !settings.minimized;
            saveSettings();
            applyMinimized();
        });
        panel.querySelector("#fr-close").addEventListener("click", () => {
            clearHighlights();
            panel.remove();
        });
        panel.querySelector("#fr-template").addEventListener("change", (e) => {
            settings.template = e.target.value;
            saveSettings();
            renderRows();
        });
        panel
            .querySelector("#fr-show-singletons")
            .addEventListener("change", (e) => {
                settings.showHiddenSingletons = e.target.checked;
                saveSettings();
                renderRows();
            });
        panel.querySelector("#fr-copy-all").addEventListener("click", () =>
            copyText(
                visibleCandidates()
                    .map((c) => generateRegex(c.edit, settings.template))
                    .filter(Boolean)
                    .join("\n")
            )
        );
        panel
            .querySelector(".fr-head")
            .addEventListener("pointerdown", startDrag);
        panel
            .querySelector(".fr-resize")
            .addEventListener("pointerdown", startResize);
        applyMinimized();
        renderRows();
    }
    function applyMinimized() {
        const panel = document.getElementById(PANEL_ID);
        if (!panel) return;
        panel
            .querySelector("#fr-toolbar")
            .classList.toggle("fr-hidden", settings.minimized);
        panel
            .querySelector("#fr-status")
            .classList.toggle("fr-hidden", settings.minimized);
        panel
            .querySelector("#fr-tablewrap")
            .classList.toggle("fr-hidden", settings.minimized);
        panel
            .querySelector(".fr-foot")
            .classList.toggle("fr-hidden", settings.minimized);
        panel
            .querySelector(".fr-resize")
            .classList.toggle("fr-hidden", settings.minimized);
        panel.style.height = settings.minimized
            ? "38px"
            : `${Math.max(260, settings.height)}px`;
        panel.querySelector("#fr-min").textContent = settings.minimized
            ? "Restore"
            : "Minimize";
    }
    function startDrag(e) {
        if (e.target.closest("button,select,input")) return;
        const panel = document.getElementById(PANEL_ID);
        if (!panel) return;
        drag = {
            x: e.clientX,
            y: e.clientY,
            left: panel.offsetLeft,
            top: panel.offsetTop
        };
        document.addEventListener("pointermove", moveDrag);
        document.addEventListener("pointerup", endDrag, { once: true });
    }
    function moveDrag(e) {
        if (!drag) return;
        const p = document.getElementById(PANEL_ID);
        if (!p) return;
        p.style.left = `${Math.max(0, drag.left + e.clientX - drag.x)}px`;
        p.style.top = `${Math.max(0, drag.top + e.clientY - drag.y)}px`;
    }
    function endDrag() {
        if (!drag) return;
        const p = document.getElementById(PANEL_ID);
        if (p) {
            settings.x = p.offsetLeft;
            settings.y = p.offsetTop;
            saveSettings();
        }
        drag = null;
        document.removeEventListener("pointermove", moveDrag);
    }
    function startResize(e) {
        e.preventDefault();
        const p = document.getElementById(PANEL_ID);
        if (!p) return;
        resize = {
            x: e.clientX,
            y: e.clientY,
            w: p.offsetWidth,
            h: p.offsetHeight
        };
        document.addEventListener("pointermove", moveResize);
        document.addEventListener("pointerup", endResize, { once: true });
    }
    function moveResize(e) {
        if (!resize) return;
        const p = document.getElementById(PANEL_ID);
        if (!p) return;
        p.style.width = `${Math.max(520, resize.w + e.clientX - resize.x)}px`;
        p.style.height = `${Math.max(260, resize.h + e.clientY - resize.y)}px`;
    }
    function endResize() {
        const p = document.getElementById(PANEL_ID);
        if (p) {
            settings.width = p.offsetWidth;
            settings.height = p.offsetHeight;
            saveSettings();
        }
        resize = null;
        document.removeEventListener("pointermove", moveResize);
    }
    function showStatus(message, error = false) {
        const el = document.querySelector(`#${PANEL_ID} #fr-status`);
        if (el) {
            el.textContent = message;
            el.classList.toggle("error", error);
        }
    }
    function visibleCandidates() {
        if (settings.showHiddenSingletons) return candidates;
        const max = Math.max(0, ...candidates.map((c) => c.frequency));
        return candidates.filter(
            (c) =>
                c.clusterSeed || c.frequency >= max * settings.singletonCutoff
        );
    }
    function renderRows() {
        const panel = document.getElementById(PANEL_ID);
        if (!panel) return;
        const tbody = panel.querySelector("#fr-rows");
        const shown = visibleCandidates();
        panel.querySelector("#fr-count").textContent =
            `${candidates.length} Candidates · ${starts.length} Starts`;
        if (!candidates.length) {
            tbody.innerHTML =
                '<tr><td colspan="6">No Candidates found.</td></tr>';
            return;
        }
        tbody.innerHTML = shown
            .map((c) => {
                const edit = c.edit ?? c.name;
                const regex = generateRegex(edit, settings.template);
                return `<tr data-id="${esc(c.id)}"><td><input class="fr-edit" aria-label="Edit Candidate" value="${esc(edit)}"><div class="fr-small">Detected: ${esc(c.name)}</div></td><td>${esc(displayAffixes(c.prefixes))}</td><td>${esc(displayAffixes(c.suffixes))}</td><td>${c.frequency}<div class="fr-small">${c.occurrenceCount} Candidate occurrences</div></td><td><div class="fr-regex">${esc(regex)}</div></td><td><button class="fr-highlight">Highlight</button> <button class="fr-copy">Copy regex</button></td></tr>`;
            })
            .join("");
        tbody.querySelectorAll("tr[data-id]").forEach((tr) => {
            const c = shown.find((x) => x.id === tr.dataset.id);
            if (!c) return;
            tr.querySelector(".fr-edit").addEventListener("input", (e) => {
                c.edit = e.target.value;
                settings.edits[c.normalized] = c.edit;
                saveSettings();
                tr.querySelector(".fr-regex").textContent = generateRegex(
                    c.edit,
                    settings.template
                );
            });
            tr.querySelector(".fr-copy").addEventListener("click", () =>
                copyText(generateRegex(c.edit, settings.template))
            );
            tr.querySelector(".fr-highlight").addEventListener("click", () =>
                toggleHighlight(c, tr.querySelector(".fr-highlight"))
            );
        });
        showStatus(
            currentText
                ? `Scanned ${currentText.length.toLocaleString()} characters. Pass One and Pass Two matching complete.`
                : "No usable visible page text was found.",
            !currentText
        );
    }
    async function copyText(text) {
        if (!text) {
            showStatus("Nothing to copy.", true);
            return;
        }
        try {
            if (typeof GM_setClipboard === "function")
                GM_setClipboard(text, "text");
            else if (navigator.clipboard?.writeText)
                await navigator.clipboard.writeText(text);
            else {
                const ta = document.createElement("textarea");
                ta.value = text;
                ta.style.position = "fixed";
                ta.style.opacity = "0";
                document.body.appendChild(ta);
                ta.select();
                const ok = document.execCommand("copy");
                ta.remove();
                if (!ok) throw new Error("Copy command failed");
            }
            showStatus("Copied regex text.");
        } catch (_) {
            showStatus(
                "Could not copy. Check browser clipboard permissions.",
                true
            );
        }
    }
    function clearHighlights() {
        try {
            if ("highlights" in CSS)
                CSS.highlights.delete("fr-scanner-highlight");
        } catch (_) {}
        highlightStyle?.remove();
        highlightStyle = null;
        highlightedCandidateId = null;
    }
    function toggleHighlight(candidate, button) {
        if (highlightedCandidateId === candidate.id) {
            clearHighlights();
            document
                .querySelectorAll("#fr-scanner-panel .fr-highlight")
                .forEach((b) => (b.textContent = "Highlight"));
            return;
        }
        clearHighlights();
        try {
            if (!("highlights" in CSS) || typeof Highlight === "undefined") {
                showStatus(
                    "This browser does not support safe page highlighting.",
                    true
                );
                return;
            }
            const ranges = [];
            const target = identity(candidate.name);
            const walker = document.createTreeWalker(
                document.body,
                NodeFilter.SHOW_TEXT,
                {
                    acceptNode(n) {
                        let p = n.parentElement;
                        while (p && p !== document.body) {
                            if (isExcluded(p) || p.closest("#" + PANEL_ID))
                                return NodeFilter.FILTER_REJECT;
                            p = p.parentElement;
                        }
                        return n.nodeValue.trim()
                            ? NodeFilter.FILTER_ACCEPT
                            : NodeFilter.FILTER_REJECT;
                    }
                }
            );
            let n;
            while ((n = walker.nextNode())) {
                const txt = n.nodeValue;
                const re = new RegExp(
                    `(^|[^\\p{L}\\p{N}])(${escapeRegex(candidate.name)})(?=$|[^\\p{L}\\p{N}])`,
                    "giu"
                );
                let m;
                while ((m = re.exec(txt))) {
                    const start = m.index + m[1].length;
                    const r = new Range();
                    r.setStart(n, start);
                    r.setEnd(n, start + m[2].length);
                    ranges.push(r);
                }
            }
            if (!ranges.length) {
                showStatus(
                    "No exact visible occurrences could be highlighted.",
                    true
                );
                return;
            }
            CSS.highlights.set(
                "fr-scanner-highlight",
                new Highlight(...ranges)
            );
            highlightStyle = document.createElement("style");
            highlightStyle.textContent =
                "::highlight(fr-scanner-highlight){background:#ffeb3b;color:#111;text-decoration:underline;text-decoration-color:#f80}";
            document.head.appendChild(highlightStyle);
            highlightedCandidateId = candidate.id;
            document
                .querySelectorAll("#fr-scanner-panel .fr-highlight")
                .forEach((b) => (b.textContent = "Highlight"));
            button.textContent = "Unhighlight";
            ranges[0].startContainer.parentElement?.scrollIntoView({
                behavior: "smooth",
                block: "center"
            });
            showStatus(
                `Highlighted ${ranges.length} visible occurrence(s) of ${candidate.name}.`
            );
        } catch (_) {
            clearHighlights();
            showStatus(
                "Highlighting failed; the page was left unchanged.",
                true
            );
        }
    }
    function runScan() {
        clearHighlights();
        try {
            currentText = extractVisibleText();
            if (!currentText) {
                candidates = [];
                starts = [];
                renderRows();
                showStatus(
                    "No usable visible page text found. Try a page containing the story text.",
                    true
                );
                return;
            }
            const result = analyze(currentText);
            candidates = result.candidates;
            starts = result.starts;
            for (const c of candidates)
                c.edit = settings.edits[c.normalized] ?? c.name;
            renderRows();
        } catch (err) {
            candidates = [];
            starts = [];
            renderRows();
            showStatus(
                `Scan failed safely: ${err?.message || "unknown error"}`,
                true
            );
        }
    }
    function initialize() {
        if (typeof GM_registerMenuCommand === "function") {
            GM_registerMenuCommand("Toggle FR Scanner", () => {
                const panel = document.getElementById("fr-scanner-panel");
                if (panel) {
                    panel.remove();
                    return;
                }
                createPanel();
                runScan();
            });
        }
    }
    if (document.readyState === "loading")
        document.addEventListener("DOMContentLoaded", initialize, {
            once: true
        });
    else initialize();
})();
