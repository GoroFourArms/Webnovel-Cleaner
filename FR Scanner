// ==UserScript==
// @name         FR Scanner
// @namespace    fr-scanner
// @version      2.0.0
// @description  Scan visible page text for capitalized Candidates and prepare template-specific regexes.
// @match        *://*/*
// @grant        GM_getValue
// @grant        GM_setValue
// @grant        GM_setClipboard
// @grant        GM_registerMenuCommand
// @updateURL    https://github.com/GoroFourArms/Webnovel-Cleaner/raw/refs/heads/main/FR%20Scanner
// @downloadURL  https://github.com/GoroFourArms/Webnovel-Cleaner/raw/refs/heads/main/FR%20Scanner
// @run-at       document-idle
// ==/UserScript==
(() => {
    "use strict";
    const STORE_KEY = "frScanner.settings.v2";
    const PANEL_ID = "fr-scanner-panel";
    const STYLE_ID = "fr-scanner-style";
    const EXCLUDED_TAGS = new Set([
        "SCRIPT",
        "STYLE",
        "NOSCRIPT",
        "TEMPLATE",
        "SVG",
        "CANVAS",
        "IFRAME",
        "NAV",
        "FOOTER",
        "HEADER",
        "ASIDE",
        "BUTTON",
        "INPUT",
        "TEXTAREA",
        "SELECT",
        "OPTION"
    ]);
    const BLOCK_TAGS = new Set([
        "ADDRESS",
        "ARTICLE",
        "BLOCKQUOTE",
        "BR",
        "DD",
        "DIV",
        "DL",
        "DT",
        "FIGCAPTION",
        "FIGURE",
        "H1",
        "H2",
        "H3",
        "H4",
        "H5",
        "H6",
        "LI",
        "MAIN",
        "P",
        "PRE",
        "SECTION",
        "TD",
        "TH",
        "TR"
    ]);
    const TEMPLATES = ["Other", "Korean", "Korean 2", "Japanese"];
    const DEFAULTS = {
        x: 24,
        y: 24,
        width: 980,
        height: 620,
        minimized: false,
        template: "Other",
        singletonCutoff: 0.05,
        showHiddenSingletons: false,
        edits: {},
        columnWidths: {}
    };
    const OCCURRENCE_RE =
        /(?<![A-Z0-9'’.-])((?:(?:Mr|Mrs|Ms|Miss|Dr|Prof|Sr|Jr|St|Rev|Hon|Capt|Col|Gen|Sgt|Lt|Maj)\.[ \t]+)?(?:[A-Z](?:\.[A-Z])+\.\.?|[A-Z]\.|[A-Z]{2,}|[A-Z][A-Za-z0-9'’-]*)(?:\s+(?:[A-Z](?:\.[A-Z])+\.\.?|[A-Z]\.|[A-Z]{2,}|[A-Z][A-Za-z0-9'’-]*))*)(?![A-Za-z0-9'’.-])/g;
    let settings = loadSettings();
    let currentText = "";
    let candidates = [];
    let starts = [];
    let highlightStyle = null;
    let highlightedCandidateId = null;
    let drag = null;
    let resize = null;
    function loadSettings() {
        try {
            const stored =
                typeof GM_getValue === "function"
                    ? GM_getValue(STORE_KEY, {})
                    : {};
            return {
                ...DEFAULTS,
                ...(stored && typeof stored === "object" ? stored : {}),
                edits: { ...(stored?.edits || {}) },
                columnWidths: { ...(stored?.columnWidths || {}) }
            };
        } catch (_) {
            return { ...DEFAULTS, edits: {}, columnWidths: {} };
        }
    }
    function saveSettings() {
        try {
            if (typeof GM_setValue === "function") {
                GM_setValue(STORE_KEY, settings);
            }
        } catch (_) {}
    }
    function normalizeSpace(s) {
        return String(s ?? "")
            .normalize("NFKC")
            .replace(/[\u2018\u2019]/g, "'")
            .replace(/[\u201C\u201D]/g, '"')
            .replace(/[\u2013\u2014\u2212]/g, "-")
            .replace(/\s+/g, " ")
            .trim();
    }
    function normalizeToken(s) {
        let v = normalizeSpace(s)
            .toLowerCase()
            .replace(/^[\s"'“”‘’([{]+|[\s"'“”‘’)}\]]+$/g, "");
        v = v.replace(/['’]s$/i, "").replace(/s['’]$/, "s");
        if (v.length > 4 && /ies$/.test(v)) v = v.slice(0, -3) + "y";
        else if (v.length > 4 && /(ches|shes|xes|zes)$/.test(v))
            v = v.slice(0, -2);
        else if (v.length > 4 && /ses$/.test(v) && !/sses$/.test(v))
            v = v.slice(0, -2);
        return v;
    }
    function tokens(s) {
        return normalizeSpace(s).split(/\s+/).filter(Boolean);
    }
    function identity(s) {
        return tokens(s).map(normalizeToken).filter(Boolean).join(" ");
    }
    function isExcluded(el) {
        if (!el || el.nodeType !== 1) return false;
        if (EXCLUDED_TAGS.has(el.tagName)) return true;
        if (el.hidden || el.getAttribute("aria-hidden") === "true") return true;
        const style = getComputedStyle(el);
        if (
            style.display === "none" ||
            style.visibility === "hidden" ||
            style.visibility === "collapse" ||
            style.opacity === "0"
        )
            return true;
        const role = (el.getAttribute("role") || "").toLowerCase();
        const cls =
            `${el.id || ""} ${typeof el.className === "string" ? el.className : ""}`.toLowerCase();
        if (
            [
                "navigation",
                "complementary",
                "banner",
                "contentinfo",
                "dialog",
                "alertdialog"
            ].includes(role)
        )
            return true;
        if (
            /(^|\b)(advert|advertisement|ad-container|popup|modal|comment|comments|recommend|related-post|chapter-list|pagination|pager|table-of-contents|toc)(\b|[-_])/i.test(
                cls
            )
        )
            return true;
        return false;
    }
    function extractVisibleText() {
        const page = document.body || document.documentElement;
        if (!page) return "";
        const MIN_TEXT_LENGTH = 300;
        function isUsable(el) {
            if (!el || el.closest("#" + PANEL_ID)) return false;
            if (isExcluded(el)) return false;
            if (!el.getClientRects().length) return false;
            const style = getComputedStyle(el);
            return (
                style.display !== "none" &&
                style.visibility !== "hidden" &&
                style.visibility !== "collapse" &&
                style.opacity !== "0"
            );
        }
        // Find visible text blocks, excluding interface elements.
        const blocks = [
            ...page.querySelectorAll("article, main, section, div")
        ].filter(isUsable);
        const textLength = (el) => {
            const walker = document.createTreeWalker(el, NodeFilter.SHOW_TEXT, {
                acceptNode(node) {
                    const parent = node.parentElement;
                    if (!node.nodeValue?.trim() || !parent) {
                        return NodeFilter.FILTER_REJECT;
                    }
                    let current = parent;
                    while (current && current !== el) {
                        if (
                            isExcluded(current) ||
                            current.closest("#" + PANEL_ID)
                        ) {
                            return NodeFilter.FILTER_REJECT;
                        }
                        current = current.parentElement;
                    }
                    return NodeFilter.FILTER_ACCEPT;
                }
            });
            let total = 0;
            let node;
            while ((node = walker.nextNode())) {
                total += node.nodeValue.trim().length;
            }
            return total;
        };
        const ranked = blocks
            .map((el) => ({ el, length: textLength(el) }))
            .filter((item) => item.length >= MIN_TEXT_LENGTH)
            .sort((a, b) => b.length - a.length);
        if (!ranked.length) return "";
        // Choose the largest text-bearing region that isn't just the whole page.
        const root = ranked.find(
            ({ el }) => el !== document.body && el !== document.documentElement
        )?.el;
        if (!root) return "";
        const pieces = [];
        const walker = document.createTreeWalker(root, NodeFilter.SHOW_TEXT, {
            acceptNode(node) {
                const el = node.parentElement;
                if (!node.nodeValue?.trim() || !el || !isUsable(el)) {
                    return NodeFilter.FILTER_REJECT;
                }
                let current = el;
                while (current && current !== root) {
                    if (
                        isExcluded(current) ||
                        current.closest("#" + PANEL_ID)
                    ) {
                        return NodeFilter.FILTER_REJECT;
                    }
                    current = current.parentElement;
                }
                return NodeFilter.FILTER_ACCEPT;
            }
        });
        let node;
        while ((node = walker.nextNode())) {
            const text = node.nodeValue
                .replace(/[\u200B-\u200D\uFEFF\u00AD]/g, " ")
                .replace(/\s+/g, " ")
                .trim();
            if (text) {
                const parentBlock = node.parentElement?.closest(
                    [...BLOCK_TAGS].join(",")
                );
                pieces.push({
                    text,
                    block: parentBlock
                });
            }
        }
        let result = "";
        let previousBlock = null;
        for (const piece of pieces) {
            if (result) {
                result +=
                    piece.block && piece.block !== previousBlock ? "\n" : " ";
            }
            result += piece.text;
            previousBlock = piece.block;
        }
        return result.trim();
    }
    function findSentenceStarts(text) {
        const starts = new Set();
        for (let i = 0; i < text.length; i++) {
            if (text[i] === "\n") {
                let next = i + 1;
                while (next < text.length && /\s/.test(text[next])) next++;
                while (next < text.length && /["'“”‘’([{]/.test(text[next]))
                    next++;
                if (next < text.length) starts.add(next);
            }
        }
        let first = 0;
        // Find the first non-whitespace character, skipping opening quotes/brackets.
        while (
            first < text.length &&
            (/\s/.test(text[first]) || /["'“”‘’([{]/.test(text[first]))
        ) {
            first++;
        }
        if (first < text.length) starts.add(first);
        // Recognized titles whose periods must not end a sentence.
        const titlePattern =
            /\b(?:Mr|Mrs|Ms|Miss|Dr|Prof|Sr|Jr|St|Rev|Hon|Capt|Col|Gen|Sgt|Lt|Maj)\./gi;
        const titlePeriods = new Set();
        for (const match of text.matchAll(titlePattern)) {
            titlePeriods.add(match.index + match[0].length - 1);
        }
        for (let i = 0; i < text.length; i++) {
            const ch = text[i];
            if (ch === ".") {
                if (titlePeriods.has(i)) continue;
                // A period after a single capital letter is an initial.
                if (
                    i > 0 &&
                    /[A-Z]/.test(text[i - 1]) &&
                    (i < 2 || !/[A-Za-z]/.test(text[i - 2]))
                ) {
                    continue;
                }
            } else if (ch !== "!" && ch !== "?") {
                continue;
            }
            // Consume consecutive sentence-ending punctuation.
            let next = i + 1;
            while (next < text.length && /[.!?]/.test(text[next])) {
                next++;
            }
            // Skip closing quotes/brackets after the punctuation.
            while (next < text.length && /["'”’)\]}]/.test(text[next])) {
                next++;
            }
            // Skip whitespace and opening quotes/brackets before the next sentence.
            while (
                next < text.length &&
                (/\s/.test(text[next]) || /["'“”‘’([{]/.test(text[next]))
            ) {
                next++;
            }
            if (next < text.length) starts.add(next);
            i = next - 1;
        }
        return starts;
    }
    function isSentenceStart(text, index, sentenceStarts) {
        // Allow whitespace and opening quotes/brackets before the occurrence.
        let i = index;
        while (
            i < text.length &&
            (/\s/.test(text[i]) || /["'“”‘’([{]/.test(text[i]))
        ) {
            i++;
        }
        return sentenceStarts.has(i);
    }
    function collect(records, kind) {
        const map = new Map();
        for (const occ of records) {
            const display = normalizeSpace(occ.text).replace(/['’]s$/i, ""),
                key = identity(display);
            if (!key) continue;
            let item = map.get(key);
            if (!item) {
                item = {
                    id: `${kind}-${map.size}-${key}`,
                    name: display,
                    normalized: key,
                    occurrenceCount: 0,
                    frequency: 0,
                    originalIndex: occ.start,
                    occurrences: [],
                    prefixes: new Map(),
                    suffixes: new Map(),
                    edit: settings.edits[key] ?? display,
                    assignedStarts: [],
                    clusterSeed: null
                };
                map.set(key, item);
            }
            item.occurrenceCount++;
            item.frequency++;
            item.occurrences.push(occ);
            if (display.length < item.name.length) item.name = display;
        }
        return [...map.values()];
    }
    function findOccurrenceSpans(text) {
        const occurrences = [];
        const sentenceStarts = findSentenceStarts(text);
        const re = new RegExp(OCCURRENCE_RE.source, OCCURRENCE_RE.flags);
        let m;
        while ((m = re.exec(text)) !== null) {
            const phrase = m[1];
            const start = m.index + m[0].indexOf(phrase);
            const end = start + phrase.length;
            occurrences.push({
                text: phrase,
                normalized: identity(phrase),
                start,
                end,
                isStart: isSentenceStart(text, start, sentenceStarts)
            });
            if (m[0].length === 0) re.lastIndex++;
        }
        return occurrences;
    }
    function classifyOccurrences(text) {
        const occurrences = findOccurrenceSpans(text);
        return {
            candidates: occurrences.filter((occurrence) => !occurrence.isStart),
            starts: occurrences.filter((occurrence) => occurrence.isStart)
        };
    }
    function passTwoCandidate(start, list) {
        const st = tokens(start.name ?? start.text)
            .map(normalizeToken)
            .filter(Boolean);
        if (!st.length) return null;
        function compareAlignments(a, b) {
            if (a.length !== b.length) {
                return a.length - b.length;
            }
            function longestRun(pairs) {
                let best = 0;
                let run = 0;
                for (let i = 0; i < pairs.length; i++) {
                    if (
                        i > 0 &&
                        pairs[i][0] === pairs[i - 1][0] + 1 &&
                        pairs[i][1] === pairs[i - 1][1] + 1
                    ) {
                        run++;
                    } else {
                        run = 1;
                    }
                    best = Math.max(best, run);
                }
                return best;
            }
            const runA = longestRun(a);
            const runB = longestRun(b);
            if (runA !== runB) {
                return runA - runB;
            }
            // Prefer the rightmost alignment, comparing from the end.
            for (let i = a.length - 1; i >= 0; i--) {
                if (a[i][1] !== b[i][1]) {
                    return a[i][1] - b[i][1];
                }
                if (a[i][0] !== b[i][0]) {
                    return a[i][0] - b[i][0];
                }
            }
            return 0;
        }
        function bestAlignment(ct) {
            const memo = new Map();
            function solve(i, j) {
                if (i >= ct.length || j >= st.length) return [];
                const key = `${i}:${j}`;
                if (memo.has(key)) return memo.get(key);
                // Option 1: skip this Candidate token.
                let best = solve(i + 1, j);
                // Option 2: skip this Start token.
                const skipStart = solve(i, j + 1);
                if (compareAlignments(skipStart, best) > 0) {
                    best = skipStart;
                }
                // Option 3: match equal tokens, preserving order.
                if (ct[i] === st[j]) {
                    const matched = [[i, j], ...solve(i + 1, j + 1)];
                    if (compareAlignments(matched, best) > 0) {
                        best = matched;
                    }
                }
                memo.set(key, best);
                return best;
            }
            return solve(0, 0);
        }
        const choices = [];
        for (const c of list) {
            const ct = tokens(c.name).map(normalizeToken).filter(Boolean);
            if (!ct.length) continue;
            const alignment = bestAlignment(ct);
            if (!alignment.length) continue;
            let longestContiguous = 1;
            let run = 1;
            for (let i = 1; i < alignment.length; i++) {
                if (
                    alignment[i][0] === alignment[i - 1][0] + 1 &&
                    alignment[i][1] === alignment[i - 1][1] + 1
                ) {
                    run++;
                } else {
                    run = 1;
                }
                longestContiguous = Math.max(longestContiguous, run);
            }
            choices.push({
                candidate: c,
                matched: alignment.length,
                totalTokens: ct.length,
                contiguous: longestContiguous,
                alignment,
                rightmost: alignment[alignment.length - 1][1],
                originalIndex: c.originalIndex
            });
        }
        choices.sort(
            (a, b) =>
                b.matched - a.matched ||
                a.totalTokens - b.totalTokens ||
                b.contiguous - a.contiguous ||
                b.rightmost - a.rightmost ||
                a.originalIndex - b.originalIndex
        );
        return choices[0] || null;
    }
    function selectedSpan(start, alignment) {
        if (!alignment?.length) return null;
        const sourceTokens = [];
        const source = start.text;
        const re = /\S+/g;
        let match;

        while ((match = re.exec(source)) !== null) {
            const value = normalizeToken(match[0]);
            if (!value) continue;
            sourceTokens.push({
                value,
                start: match.index,
                end: match.index + match[0].length
            });
        }

        // Pass Two alignment pairs are [candidateTokenIndex, startTokenIndex].
        const sourceIndexes = alignment.map((pair) => pair[1]);

        if (
            sourceIndexes.some(
                (index) =>
                    !Number.isInteger(index) ||
                    index < 0 ||
                    index >= sourceTokens.length
            )
        ) {
            return null;
        }

        const first = Math.min(...sourceIndexes);
        const last = Math.max(...sourceIndexes);

        return {
            start: sourceTokens[first].start,
            end: sourceTokens[last].end
        };
    }
    function affixesFor(occurrence, alignment) {
        const span = selectedSpan(occurrence, alignment);
        if (!span) {
            return { prefix: "", suffix: "" };
        }
        const clean = (value) => value.replace(/[\p{P}\p{S}\s]+/gu, " ").trim();
        return {
            prefix: clean(occurrence.text.slice(0, span.start)),
            suffix: clean(occurrence.text.slice(span.end))
        };
    }
    function addAffix(map, value) {
        if (!value) return;
        map.set(value, (map.get(value) || 0) + 1);
    }
    function findExactCandidate(start, candidates) {
        return (
            candidates.find(
                (candidate) => candidate.normalized === start.normalized
            ) || null
        );
    }
    function analyze(text) {
        const classified = classifyOccurrences(text);
        const candidateOccurrences = classified.candidates;
        const startOccurrences = classified.starts;
        const list = collect(candidateOccurrences, "c");
        const startList = collect(startOccurrences, "s");
        // Pass One: exact full normalized identity.
        for (const s of startList) {
            const c = findExactCandidate(s, list);
            if (!c) continue;
            c.frequency += s.occurrenceCount;
            c.assignedStarts.push({ start: s, pass: 1 });
            s.matchedCandidate = c;
            s.matchPass = 1;
            // Pass One matches contribute affixes too.
            for (const occ of s.occurrences) {
                const alignment = tokens(c.name)
                    .map(normalizeToken)
                    .filter(Boolean)
                    .map((_, index) => [index, index]);
                const affix = affixesFor(occ, c, alignment);
                addAffix(c.prefixes, affix.prefix);
                addAffix(c.suffixes, affix.suffix);
            }
        }
        // Pass Two: remaining Starts. Every Start can be assigned at most once.
        for (const s of startList) {
            if (s.matchedCandidate) continue;
            const match = passTwoCandidate(s, list);
            if (!match) continue;
            const c = match.candidate;
            c.frequency += s.occurrenceCount;
            c.assignedStarts.push({ start: s, pass: 2 });
            s.matchedCandidate = c;
            s.matchPass = 2;
            for (const occ of s.occurrences) {
                const affix = affixesFor(occ, c, match.alignment);
                addAffix(c.prefixes, affix.prefix);
                addAffix(c.suffixes, affix.suffix);
            }
        }
        buildClusters(list);
        return {
            candidates: list,
            starts: startList,
            scanned: candidateOccurrences.length + startOccurrences.length
        };
    }
    function sharedToken(a, b) {
        const aa = new Set(tokens(a).map(normalizeToken));
        return tokens(b)
            .map(normalizeToken)
            .some((t) => aa.has(t));
    }
    function buildClusters(list) {
        const ordered = [...list].sort(
            (a, b) =>
                b.frequency - a.frequency || a.originalIndex - b.originalIndex
        );
        for (const candidate of ordered) {
            candidate.clusterSeed = null;
        }
        const claimed = new Set();
        const result = [];
        for (const seed of ordered) {
            if (claimed.has(seed)) continue;
            // Keep the seed first.
            result.push(seed);
            claimed.add(seed);
            // Degree 1: direct matches to the seed.
            const direct = ordered.filter(
                (candidate) =>
                    !claimed.has(candidate) &&
                    sharedToken(seed.name, candidate.name)
            );
            if (direct.length === 0) {
                seed.clusterSeed = null;
                continue;
            }
            seed.clusterSeed = seed;
            for (const member of direct) {
                member.clusterSeed = seed;
                claimed.add(member);
                result.push(member);
            }
            // Degree 2: one bridge pass through degree-1 members only.
            for (const bridge of direct) {
                for (const candidate of ordered) {
                    if (claimed.has(candidate)) continue;
                    if (sharedToken(bridge.name, candidate.name)) {
                        candidate.clusterSeed = seed;
                        claimed.add(candidate);
                        result.push(candidate);
                    }
                }
            }
        }
        list.splice(0, list.length, ...result);
    }
    function escapeRegex(s) {
        return String(s).replace(/[.*+?^${}()|[\]\\]/g, "\\$&");
    }
    function generateRegex(candidate, template) {
        const value = normalizeSpace(candidate);
        if (!value) return "";
        let source = escapeRegex(value);
        if (template === "Korean") {
            // Treat hyphens as an optional separator: hyphen, space, or nothing.
            source = source.replace(/-/g, "[ -]?").replace(/\s+/g, "[ -]?");
        } else if (template === "Korean 2") {
            source = source.replace(/-/g, "[- ]?").replace(/\s+/g, "[- ]+");
        } else if (template === "Japanese") {
            source = source.replace(/\s+/g, "\\s*");
        }
        return source;
    }
    function displayAffixes(map) {
        if (!map.size) return "—";
        return [...map.entries()]
            .sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]))
            .map(([v, n]) => `${v} (${n})`)
            .join(", ");
    }
    function esc(s) {
        return String(s ?? "").replace(
            /[&<>"']/g,
            (c) =>
                ({
                    "&": "&amp;",
                    "<": "&lt;",
                    ">": "&gt;",
                    '"': "&quot;",
                    "'": "&#39;"
                })[c]
        );
    }
    function ensureStyle() {
        if (document.getElementById(STYLE_ID)) return;
        const style = document.createElement("style");
        style.id = STYLE_ID;
        style.textContent = `#${PANEL_ID}{position:fixed;z-index:2147483646;background:#17191d;color:#f2f3f5;border:1px solid #555;border-radius:8px;box-shadow:0 8px 32px #0008;font:13px/1.4 system-ui,sans-serif;display:flex;flex-direction:column;overflow:hidden}#${PANEL_ID} *{box-sizing:border-box}#${PANEL_ID} .fr-head{display:flex;align-items:center;gap:8px;padding:8px 10px;background:#24272d;cursor:move;user-select:none}#${PANEL_ID} .fr-head strong{font-size:14px}#${PANEL_ID} button,#${PANEL_ID} select{background:#343840;color:#f2f3f5;border:1px solid #555;border-radius:4px;padding:4px 7px;cursor:pointer}#${PANEL_ID} button:hover{background:#454a54}#${PANEL_ID} .fr-toolbar{display:flex;flex-wrap:wrap;gap:6px;padding:8px;border-bottom:1px solid #45484e}#${PANEL_ID} .fr-status{padding:5px 9px;color:#c7ccd4}#${PANEL_ID} .fr-status.error{color:#ff9999}#${PANEL_ID} .fr-tablewrap{overflow:auto;flex:1;min-height:0}#${PANEL_ID} table{border-collapse:collapse;width:max-content;min-width:100%;table-layout:auto}#${PANEL_ID} th,#${PANEL_ID} td{border-bottom:1px solid #363940;padding:6px;text-align:left;vertical-align:top;overflow-wrap:anywhere;max-width:400px}#${PANEL_ID} th{position:sticky;top:0;background:#25282e;z-index:1;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}#${PANEL_ID} td input{width:100%;min-width:80px;background:#101216;color:#fff;border:1px solid #555;border-radius:3px;padding:5px}#${PANEL_ID} .fr-regex{font:12px/1.35 ui-monospace,monospace;white-space:pre-wrap;word-break:break-all}#${PANEL_ID} .fr-small{font-size:11px;color:#bdc2ca}#${PANEL_ID} .fr-resize{height:7px;cursor:ns-resize;background:#292c32}#${PANEL_ID} .fr-colresize{display:inline-block;float:right;width:5px;height:20px;cursor:col-resize}#${PANEL_ID} .fr-foot{padding:6px 9px;color:#aeb4be;border-top:1px solid #444;font-size:11px}#${PANEL_ID} .fr-hidden{display:none!important}`;
        document.head.appendChild(style);
    }
    function createPanel() {
        if (document.getElementById(PANEL_ID)) return;
        ensureStyle();
        const panel = document.createElement("section");
        panel.id = PANEL_ID;
        panel.style.left = `${Math.max(0, settings.x)}px`;
        panel.style.top = `${Math.max(0, settings.y)}px`;
        panel.style.width = `${Math.max(520, settings.width)}px`;
        panel.style.height = `${Math.max(260, settings.height)}px`;
        panel.innerHTML = `
        <div class="fr-head">
            <span id="fr-count" class="fr-small"></span>
            <span style="flex:1"></span>
            <button id="fr-rescan">Rescan</button>
            <button id="fr-min">${settings.minimized ? "Restore" : "Minimize"}</button>
            <button id="fr-close" title="Close panel">×</button>
        </div>
        <div class="fr-toolbar" id="fr-toolbar">
            <label>Template
                <select id="fr-template">
                    ${TEMPLATES.map((t) => `<option>${esc(t)}</option>`).join("")}
                </select>
            </label>
        </div>
        <div class="fr-tablewrap" id="fr-tablewrap">
            <table>
                <thead>
                    <tr>
                        <th data-col="candidate">Candidate</th>
                        <th data-col="prefix">Prefix</th>
                        <th data-col="suffix">Suffix</th>
                        <th data-col="frequency">#</th>
                        <th data-col="regex" title="Generated regex">Regex</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody id="fr-rows"></tbody>
            </table>
        </div>
        <div class="fr-resize" title="Resize panel"></div>
    `;
        document.body.appendChild(panel);
        panel.querySelector("#fr-template").value = settings.template;
        panel.querySelector("#fr-rescan").addEventListener("click", runScan);
        panel.querySelector("#fr-min").addEventListener("click", () => {
            settings.minimized = !settings.minimized;
            saveSettings();
            applyMinimized();
        });
        panel.querySelector("#fr-close").addEventListener("click", () => {
            clearHighlights();
            panel.remove();
        });
        panel.querySelector("#fr-template").addEventListener("change", (e) => {
            settings.template = e.target.value;
            saveSettings();
            renderRows();
        });
        panel
            .querySelector(".fr-head")
            .addEventListener("pointerdown", startDrag);
        panel
            .querySelector(".fr-resize")
            .addEventListener("pointerdown", startResize);
        applyMinimized();
        renderRows();
    }
    function applyMinimized() {
        const panel = document.getElementById(PANEL_ID);
        if (!panel) return;
        panel
            .querySelector("#fr-toolbar")
            .classList.toggle("fr-hidden", settings.minimized);
        panel
            .querySelector("#fr-tablewrap")
            .classList.toggle("fr-hidden", settings.minimized);
        panel
            .querySelector(".fr-resize")
            .classList.toggle("fr-hidden", settings.minimized);
        panel.style.height = settings.minimized
            ? "38px"
            : `${Math.max(260, settings.height)}px`;
        panel.querySelector("#fr-min").textContent = settings.minimized
            ? "Restore"
            : "Minimize";
    }
    function startDrag(e) {
        if (e.target.closest("button,select,input")) return;
        const panel = document.getElementById(PANEL_ID);
        if (!panel) return;
        drag = {
            x: e.clientX,
            y: e.clientY,
            left: panel.offsetLeft,
            top: panel.offsetTop
        };
        document.addEventListener("pointermove", moveDrag);
        document.addEventListener("pointerup", endDrag, { once: true });
    }
    function moveDrag(e) {
        if (!drag) return;
        const p = document.getElementById(PANEL_ID);
        if (!p) return;
        p.style.left = `${Math.max(0, drag.left + e.clientX - drag.x)}px`;
        p.style.top = `${Math.max(0, drag.top + e.clientY - drag.y)}px`;
    }
    function endDrag() {
        if (!drag) return;
        const p = document.getElementById(PANEL_ID);
        if (p) {
            settings.x = p.offsetLeft;
            settings.y = p.offsetTop;
            saveSettings();
        }
        drag = null;
        document.removeEventListener("pointermove", moveDrag);
    }
    function startResize(e) {
        e.preventDefault();
        const p = document.getElementById(PANEL_ID);
        if (!p) return;
        resize = {
            x: e.clientX,
            y: e.clientY,
            w: p.offsetWidth,
            h: p.offsetHeight
        };
        document.addEventListener("pointermove", moveResize);
        document.addEventListener("pointerup", endResize, { once: true });
    }
    function moveResize(e) {
        if (!resize) return;
        const p = document.getElementById(PANEL_ID);
        if (!p) return;
        p.style.width = `${Math.max(520, resize.w + e.clientX - resize.x)}px`;
        p.style.height = `${Math.max(260, resize.h + e.clientY - resize.y)}px`;
    }
    function endResize() {
        const p = document.getElementById(PANEL_ID);
        if (p) {
            settings.width = p.offsetWidth;
            settings.height = p.offsetHeight;
            saveSettings();
        }
        resize = null;
        document.removeEventListener("pointermove", moveResize);
    }
    function visibleCandidates() {
        if (settings.showHiddenSingletons) return candidates;
        const max = Math.max(0, ...candidates.map((c) => c.frequency));
        return candidates.filter(
            (c) =>
                c.clusterSeed || c.frequency >= max * settings.singletonCutoff
        );
    }
    function renderRows() {
        const panel = document.getElementById(PANEL_ID);
        if (!panel) return;
        const tbody = panel.querySelector("#fr-rows");
        const shown = visibleCandidates();
        panel.querySelector("#fr-count").textContent =
            `${candidates.length} Candidates · ${starts.length} Starts`;
        if (!candidates.length) {
            tbody.innerHTML = "";
            return;
        }
        tbody.innerHTML = shown
            .map((c) => {
                const edit = c.edit ?? c.name;
                const regex = generateRegex(edit, settings.template);
                return `<tr data-id="${esc(c.id)}">
            <td><input class="fr-edit" aria-label="Edit Candidate" value="${esc(edit)}"></td>
            <td>${esc(displayAffixes(c.prefixes))}</td>
            <td>${esc(displayAffixes(c.suffixes))}</td>
            <td>${c.frequency}</td>
            <td><div class="fr-regex">${esc(regex)}</div></td>
            <td><button class="fr-highlight">Highlight</button> <button class="fr-copy">Copy regex</button></td>
        </tr>`;
            })
            .join("");
        tbody.querySelectorAll("tr[data-id]").forEach((tr) => {
            const c = shown.find((x) => x.id === tr.dataset.id);
            if (!c) return;
            tr.querySelector(".fr-edit").addEventListener("input", (e) => {
                c.edit = e.target.value;
                settings.edits[c.normalized] = c.edit;
                saveSettings();
                tr.querySelector(".fr-regex").textContent = generateRegex(
                    c.edit,
                    settings.template
                );
            });
            tr.querySelector(".fr-copy").addEventListener("click", () =>
                copyText(generateRegex(c.edit, settings.template))
            );
            tr.querySelector(".fr-highlight").addEventListener("click", () =>
                toggleHighlight(c, tr.querySelector(".fr-highlight"))
            );
        });
    }
    async function copyText(text) {
        if (!text) {
            showStatus("Nothing to copy.", true);
            return;
        }
        try {
            if (typeof GM_setClipboard === "function")
                GM_setClipboard(text, "text");
            else if (navigator.clipboard?.writeText)
                await navigator.clipboard.writeText(text);
            else {
                const ta = document.createElement("textarea");
                ta.value = text;
                ta.style.position = "fixed";
                ta.style.opacity = "0";
                document.body.appendChild(ta);
                ta.select();
                const ok = document.execCommand("copy");
                ta.remove();
                if (!ok) throw new Error("Copy command failed");
            }
            showStatus("Copied regex text.");
        } catch (_) {
            showStatus(
                "Could not copy. Check browser clipboard permissions.",
                true
            );
        }
    }
    function clearHighlights() {
        try {
            if ("highlights" in CSS)
                CSS.highlights.delete("fr-scanner-highlight");
        } catch (_) {}
        highlightStyle?.remove();
        highlightStyle = null;
        highlightedCandidateId = null;
    }
    function toggleHighlight(candidate, button) {
        if (highlightedCandidateId === candidate.id) {
            clearHighlights();
            document
                .querySelectorAll("#fr-scanner-panel .fr-highlight")
                .forEach((b) => (b.textContent = "Highlight"));
            return;
        }
        clearHighlights();
        try {
            if (!("highlights" in CSS) || typeof Highlight === "undefined") {
                showStatus(
                    "This browser does not support safe page highlighting.",
                    true
                );
                return;
            }
            const ranges = [];
            const target = identity(candidate.name);
            const walker = document.createTreeWalker(
                document.body,
                NodeFilter.SHOW_TEXT,
                {
                    acceptNode(n) {
                        let p = n.parentElement;
                        while (p && p !== document.body) {
                            if (isExcluded(p) || p.closest("#" + PANEL_ID))
                                return NodeFilter.FILTER_REJECT;
                            p = p.parentElement;
                        }
                        return n.nodeValue.trim()
                            ? NodeFilter.FILTER_ACCEPT
                            : NodeFilter.FILTER_REJECT;
                    }
                }
            );
            let n;
            while ((n = walker.nextNode())) {
                const txt = n.nodeValue;
                const re = new RegExp(
                    `(^|[^\\p{L}\\p{N}])(${escapeRegex(candidate.name)})(?=$|[^\\p{L}\\p{N}])`,
                    "gu"
                );
                let m;
                while ((m = re.exec(txt))) {
                    const start = m.index + m[1].length;
                    const r = new Range();
                    r.setStart(n, start);
                    r.setEnd(n, start + m[2].length);
                    ranges.push(r);
                }
            }
            if (!ranges.length) {
                showStatus(
                    "No exact visible occurrences could be highlighted.",
                    true
                );
                return;
            }
            CSS.highlights.set(
                "fr-scanner-highlight",
                new Highlight(...ranges)
            );
            highlightStyle = document.createElement("style");
            highlightStyle.textContent =
                "::highlight(fr-scanner-highlight){background:#ffeb3b;color:#111;text-decoration:underline;text-decoration-color:#f80}";
            document.head.appendChild(highlightStyle);
            highlightedCandidateId = candidate.id;
            document
                .querySelectorAll("#fr-scanner-panel .fr-highlight")
                .forEach((b) => (b.textContent = "Highlight"));
            button.textContent = "Unhighlight";
            ranges[0].startContainer.parentElement?.scrollIntoView({
                behavior: "smooth",
                block: "center"
            });
            showStatus(
                `Highlighted ${ranges.length} visible occurrence(s) of ${candidate.name}.`
            );
        } catch (_) {
            clearHighlights();
            showStatus(
                "Highlighting failed; the page was left unchanged.",
                true
            );
        }
    }
    function runScan() {
        clearHighlights();
        try {
            currentText = extractVisibleText();
            if (!currentText) {
                candidates = [];
                starts = [];
                renderRows();
                showStatus(
                    "No usable visible page text found. Try a page containing the story text.",
                    true
                );
                return;
            }
            const result = analyze(currentText);
            candidates = result.candidates;
            starts = result.starts;
            for (const c of candidates)
                c.edit = settings.edits[c.normalized] ?? c.name;
            renderRows();
        } catch (err) {
            candidates = [];
            starts = [];
            renderRows();
            showStatus(
                `Scan failed safely: ${err?.message || "unknown error"}`,
                true
            );
        }
    }
    function initialize() {
        if (typeof GM_registerMenuCommand === "function") {
            GM_registerMenuCommand("Toggle FR Scanner", () => {
                const panel = document.getElementById(PANEL_ID);
                if (panel) {
                    clearHighlights();
                    panel.remove();
                    return;
                }
                createPanel();
                runScan();
            });
        } else {
            console.error(
                "FR Scanner: GM_registerMenuCommand is unavailable. Check userscript-manager permissions."
            );
        }
    }
    if (document.readyState === "loading")
        document.addEventListener("DOMContentLoaded", initialize, {
            once: true
        });
    else initialize();
})();
