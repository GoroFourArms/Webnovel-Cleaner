            }
            #${PANEL_ID} button:hover { background: #454a54; }
            #${PANEL_ID} .fr-toolbar {
                display: flex;
                flex-wrap: wrap;
                gap: 6px;
                padding: 8px;
                border-bottom: 1px solid #45484e;
            }
            #${PANEL_ID} .fr-status {
                padding: 5px 9px;
                color: #c7ccd4;
                border-bottom: 1px solid #363940;
            }
            #${PANEL_ID} .fr-status.error { color: #ff9999; }
            #${PANEL_ID} .fr-tablewrap {
                overflow: auto;
                flex: 1;
                min-height: 0;
            }
            #${PANEL_ID} table {
                border-collapse: collapse;
                width: max-content;
                min-width: 100%;
                table-layout: fixed;
            }
            #${PANEL_ID} th,
            #${PANEL_ID} td {
                border-bottom: 1px solid #363940;
                padding: 6px;
                text-align: left;
                vertical-align: top;
                overflow-wrap: anywhere;
                max-width: 400px;
            }
            #${PANEL_ID} th {
                position: sticky;
                top: 0;
                background: #25282e;
                z-index: 1;
                white-space: nowrap;
                overflow: hidden;
                text-overflow: ellipsis;
            }
            #${PANEL_ID} td input {
                width: 100%;
                min-width: 100px;
                background: #101216;
                color: #fff;
                border: 1px solid #555;
                border-radius: 3px;
                padding: 5px;
            }
            #${PANEL_ID} .fr-regex {
                font: 12px/1.35 ui-monospace, monospace;
                white-space: pre-wrap;
                word-break: break-all;
            }
            #${PANEL_ID} .fr-small {
                font-size: 11px;
                color: #bdc2ca;
            }
            #${PANEL_ID} .fr-resize {
                height: 7px;
                cursor: ns-resize;
                background: #292c32;
                flex-shrink: 0;
            }
            #${PANEL_ID} .fr-colresize {
                position: absolute;
                top: 0;
                right: 0;
                width: 6px;
                height: 100%;
                cursor: col-resize;
                user-select: none;
                touch-action: none;
                z-index: 2;
            }
