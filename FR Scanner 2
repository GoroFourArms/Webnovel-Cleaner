    function startDrag(event) {
        if (event.button !== 0) return;
        // Do not start dragging when the user interacts with a control.
        if (event.target.closest("button, input, select, textarea, a")) {
            return;
        }
        const panel = document.getElementById(PANEL_ID);
        if (!panel || settings.minimized) return;
        event.preventDefault();
        const startPointerX = event.clientX;
        const startPointerY = event.clientY;
        const startLeft = panel.getBoundingClientRect().left;
        const startTop = panel.getBoundingClientRect().top;
        function onPointerMove(moveEvent) {
            const maxLeft = Math.max(0, window.innerWidth - panel.offsetWidth);
            const maxTop = Math.max(0, window.innerHeight - panel.offsetHeight);
            const newLeft = Math.min(
                maxLeft,
                Math.max(0, startLeft + moveEvent.clientX - startPointerX)
            );
            const newTop = Math.min(
                maxTop,
                Math.max(0, startTop + moveEvent.clientY - startPointerY)
            );
            panel.style.left = `${newLeft}px`;
            panel.style.top = `${newTop}px`;
            panel.style.right = "auto";
            panel.style.bottom = "auto";
            settings.x = newLeft;
            settings.y = newTop;
        }
        function onPointerUp() {
            document.removeEventListener("pointermove", onPointerMove);
            document.removeEventListener("pointerup", onPointerUp);
            saveSettings();
        }
        document.addEventListener("pointermove", onPointerMove);
        document.addEventListener("pointerup", onPointerUp);
    }
    function moveDrag(event) {
        if (!drag) return;
        const panel = document.getElementById(PANEL_ID);
        if (!panel) return;
        panel.style.left = `${Math.max(0, drag.left + event.clientX - drag.x)}px`;
        panel.style.top = `${Math.max(0, drag.top + event.clientY - drag.y)}px`;
    }
    function endDrag() {
        if (!drag) return;
        const panel = document.getElementById(PANEL_ID);
        if (panel) {
            settings.x = panel.offsetLeft;
            settings.y = panel.offsetTop;
            saveSettings();
        }
        drag = null;
        document.removeEventListener("pointermove", moveDrag);
    }
    function startResize(event) {
        if (event.button !== 0) return;
        const panel = document.getElementById(PANEL_ID);
        if (!panel || settings.minimized) return;
        event.preventDefault();
        event.stopPropagation();
        const startPointerX = event.clientX;
        const startPointerY = event.clientY;
        const startWidth = panel.getBoundingClientRect().width;
        const startHeight = panel.getBoundingClientRect().height;
        const minWidth = 420;
        const minHeight = 240;
        function onPointerMove(moveEvent) {
            const maxWidth = Math.max(
                minWidth,
                window.innerWidth - panel.getBoundingClientRect().left
            );
            const maxHeight = Math.max(
                minHeight,
                window.innerHeight - panel.getBoundingClientRect().top
            );
            const newWidth = Math.min(
                maxWidth,
                Math.max(
                    minWidth,
                    startWidth + moveEvent.clientX - startPointerX
                )
            );
            const newHeight = Math.min(
                maxHeight,
                Math.max(
                    minHeight,
                    startHeight + moveEvent.clientY - startPointerY
                )
            );
            panel.style.width = `${newWidth}px`;
            panel.style.height = `${newHeight}px`;
            settings.width = newWidth;
            settings.height = newHeight;
        }
        function onPointerUp() {
            document.removeEventListener("pointermove", onPointerMove);
            document.removeEventListener("pointerup", onPointerUp);
            saveSettings();
        }
        document.addEventListener("pointermove", onPointerMove);
        document.addEventListener("pointerup", onPointerUp);
    }
    function moveResize(event) {
        if (!resize) return;
        const panel = document.getElementById(PANEL_ID);
        if (!panel) return;
        panel.style.width = `${Math.max(520, resize.w + event.clientX - resize.x)}px`;
        panel.style.height = `${Math.max(260, resize.h + event.clientY - resize.y)}px`;
    }
    function endResize() {
        const panel = document.getElementById(PANEL_ID);
        if (panel) {
            settings.width = panel.offsetWidth;
            settings.height = panel.offsetHeight;
            saveSettings();
        }
        resize = null;
        document.removeEventListener("pointermove", moveResize);
    }
    // ---------------------------------------------------------------------
    // Column resizing
    // ---------------------------------------------------------------------
    function applyColumnWidths() {
        const panel = document.getElementById(PANEL_ID);
        if (!panel) return;
        const table = panel.querySelector("table");
        const headers = [...table.querySelectorAll("thead th")];
        headers.forEach((header) => {
            const key = header.dataset.col;
            if (!key) return;
            const width = settings.columnWidths?.[key];
            if (Number.isFinite(width) && width > 0) {
                header.style.width = `${Math.max(50, Math.min(400, width))}px`;
            }
            if (header.querySelector(".fr-colresize")) return;
            const handle = document.createElement("span");
            handle.className = "fr-colresize";
            handle.title = "Drag to resize column";
            handle.setAttribute("aria-label", `Resize ${key} column`);
            handle.addEventListener("pointerdown", (event) => {
                startColumnResize(event, key, header);
            });
            header.appendChild(handle);
        });
    }
    function startColumnResize(event, key, header) {
        event.preventDefault();
        event.stopPropagation();
        columnResize = {
            key,
            startX: event.clientX,
            startWidth: header.getBoundingClientRect().width
        };
        document.addEventListener("pointermove", moveColumnResize);
        document.addEventListener("pointerup", endColumnResize, { once: true });
    }
    function moveColumnResize(event) {
        if (!columnResize) return;
        const panel = document.getElementById(PANEL_ID);
        if (!panel) return;
        const header = panel.querySelector(
            `th[data-col="${columnResize.key}"]`
        );
        if (!header) return;
        const width = Math.max(
            50,
            Math.min(
                400,
                columnResize.startWidth + event.clientX - columnResize.startX
            )
        );
        header.style.width = `${width}px`;
    }
    function endColumnResize() {
        const panel = document.getElementById(PANEL_ID);
        if (panel && columnResize) {
            const header = panel.querySelector(
                `th[data-col="${columnResize.key}"]`
            );
            if (header) {
                settings.columnWidths ??= {};
                settings.columnWidths[columnResize.key] = Math.round(
                    header.getBoundingClientRect().width
                );
                saveSettings();
            }
        }
        columnResize = null;
        document.removeEventListener("pointermove", moveColumnResize);
    }
    // ---------------------------------------------------------------------
    // Table rendering
    // ---------------------------------------------------------------------
    function visibleCandidates() {
        if (settings.showHiddenSingletons) return candidates;
        return candidates.filter((candidate) => !candidate.hiddenByCutoff);
    }
    function renderRows() {
        const panel = document.getElementById(PANEL_ID);
        if (!panel) return;
        const tbody = panel.querySelector("#fr-rows");
        const countEl = panel.querySelector("#fr-count");
        if (!tbody || !countEl) return;
        const shown = visibleCandidates();
        const totalOccurrences = candidates.reduce(
            (total, candidate) => total + (candidate.occurrenceCount || 0),
            0
        );
        const hiddenCount = candidates.length - shown.length;
        countEl.textContent =
            `${candidates.length} phrases · ${shown.length} shown · ` +
            `${totalOccurrences} occurrences`;
        if (typeof applyColumnWidths === "function") {
            applyColumnWidths();
        }
        if (shown.length === 0) {
            tbody.innerHTML = "";
            if (candidates.length > 0 && hiddenCount > 0) {
                showStatus(
                    `${hiddenCount} phrase(s) are hidden by the token-count filter. ` +
                        "Enable “Show filtered” to display them."
                );
            }
            return;
        }
        tbody.innerHTML = shown
            .map((candidate) => {
                const edit = candidate.edit ?? candidate.name ?? "";
                const regex = generateRegex(edit, settings.template);
                return `
            <tr data-id="${esc(candidate.id)}">
                <td>
                    <input
                        class="fr-edit"
                        aria-label="Edit candidate"
                        value="${esc(edit)}"
                    >
                    <div class="fr-small">
                        ${candidate.occurrenceCount || 0} occurrence(s)
                    </div>
                </td>
                <td title="Token counts in the phrase's original token order">
                    ${esc(candidate.countDisplay ?? "")}
                </td>
                <td>
                    <div class="fr-regex">${esc(regex)}</div>
                </td>
                <td>
                    <button type="button" class="fr-highlight">Highlight</button>
                    <button type="button" class="fr-copy">Copy regex</button>
                </td>
            </tr>
        `;
            })
            .join("");
        if (typeof applyColumnWidths === "function") {
            applyColumnWidths();
        }
        tbody.querySelectorAll("tr[data-id]").forEach((row) => {
            const candidate = shown.find(
                (item) => String(item.id) === row.dataset.id
            );
            if (!candidate) return;
            const editInput = row.querySelector(".fr-edit");
            const regexDisplay = row.querySelector(".fr-regex");
            const copyButton = row.querySelector(".fr-copy");
            const highlightButton = row.querySelector(".fr-highlight");
            editInput.addEventListener("input", (event) => {
                candidate.edit = event.target.value;
                settings.edits[candidate.normalized] = candidate.edit;
                saveSettings();
                regexDisplay.textContent = generateRegex(
                    candidate.edit,
                    settings.template
                );
            });
            copyButton.addEventListener("click", () => {
                copyText(
                    generateRegex(
                        candidate.edit ?? candidate.name ?? "",
                        settings.template
                    )
                );
            });
            highlightButton.addEventListener("click", () => {
                toggleHighlight(candidate, highlightButton);
            });
        });
        if (hiddenCount > 0) {
            showStatus(
                `${hiddenCount} phrase(s) are hidden by the token-count filter. ` +
                    "Enable “Show filtered” to display them."
            );
        }
    }
    function createWordFilterControls() {
        const panel = document.getElementById(PANEL_ID);
        if (!panel) return;
        const host = panel.querySelector("#fr-word-filter-host");
        if (!host) return;
        function renderFilters() {
            host.innerHTML = "";
            const title = document.createElement("div");
            title.className = "fr-filter-title";
            title.textContent = "Word filters (case-sensitive)";
            host.appendChild(title);
            const addRow = document.createElement("div");
            addRow.className = "fr-filter-add";
            const wordInput = document.createElement("input");
            wordInput.type = "text";
            wordInput.placeholder = "Enter word or phrase";
            wordInput.setAttribute("aria-label", "Word to filter");
            const modeSelect = document.createElement("select");
            modeSelect.setAttribute("aria-label", "Word filter mode");
            for (const mode of ["Single Token", "Anytime"]) {
                const option = document.createElement("option");
                option.value = mode;
                option.textContent = mode;
                modeSelect.appendChild(option);
            }
            const addButton = document.createElement("button");
            addButton.type = "button";
            addButton.textContent = "Add filter";
            addButton.addEventListener("click", () => {
                const word = wordInput.value.trim();
                if (!word) {
                    showStatus("Enter a word or phrase to add a filter.", true);
                    wordInput.focus();
                    return;
                }
                settings.wordFilters[word] = modeSelect.value;
                saveSettings();
                renderFilters();
                runScan();
            });
            wordInput.addEventListener("keydown", (event) => {
                if (event.key === "Enter") {
                    event.preventDefault();
                    addButton.click();
                }
            });
            addRow.append(wordInput, modeSelect, addButton);
            host.appendChild(addRow);
            const filters = Object.entries(settings.wordFilters || {});
            const list = document.createElement("div");
            list.className = "fr-filter-list";
            if (filters.length === 0) {
                const empty = document.createElement("div");
                empty.className = "fr-small";
                empty.textContent = "No word filters added.";
                list.appendChild(empty);
            }
            for (const [word, mode] of filters) {
                const row = document.createElement("div");
                row.className = "fr-filter-row";
                const wordLabel = document.createElement("span");
                wordLabel.className = "fr-filter-word";
                wordLabel.textContent = word;
                const filterMode = document.createElement("select");
                filterMode.setAttribute(
                    "aria-label",
                    `Filter mode for ${word}`
                );
                for (const optionMode of ["Single Token", "Anytime"]) {
                    const option = document.createElement("option");
                    option.value = optionMode;
                    option.textContent = optionMode;
                    filterMode.appendChild(option);
                }
                filterMode.value = mode;
                filterMode.addEventListener("change", () => {
                    settings.wordFilters[word] = filterMode.value;
                    saveSettings();
                    runScan();
                });
                const removeButton = document.createElement("button");
                removeButton.type = "button";
                removeButton.textContent = "Remove";
                removeButton.setAttribute(
                    "aria-label",
                    `Remove filter ${word}`
                );
                removeButton.addEventListener("click", () => {
                    delete settings.wordFilters[word];
                    saveSettings();
                    renderFilters();
                    runScan();
                });
                row.append(wordLabel, filterMode, removeButton);
                list.appendChild(row);
            }
            host.appendChild(list);
        }
        renderFilters();
    }
    async function copyText(text) {
        if (!text) {
            showStatus("Nothing to copy.", true);
            return;
        }
        try {
            if (typeof GM_setClipboard === "function") {
                GM_setClipboard(text, "text");
            } else if (navigator.clipboard?.writeText) {
                await navigator.clipboard.writeText(text);
            } else {
                const textarea = document.createElement("textarea");
                textarea.value = text;
                textarea.style.position = "fixed";
                textarea.style.opacity = "0";
                document.body.appendChild(textarea);
                textarea.select();
                const success = document.execCommand("copy");
                textarea.remove();
                if (!success) throw new Error("Copy command failed");
            }
            showStatus("Copied regex text.");
        } catch (_) {
            showStatus(
                "Could not copy. Check browser clipboard permissions.",
                true
            );
        }
    }
    // ---------------------------------------------------------------------
    // Highlighting
    // ---------------------------------------------------------------------
    function clearHighlights() {
        try {
            if ("highlights" in CSS) {
                CSS.highlights.delete("fr-scanner-highlight");
            }
        } catch (_) {}
        highlightStyle?.remove();
        highlightStyle = null;
        highlightedCandidateId = null;
    }
    function toggleHighlight(candidate, button) {
        if (highlightedCandidateId === candidate.id) {
            clearHighlights();
            document
                .querySelectorAll("#fr-scanner-panel .fr-highlight")
                .forEach((item) => {
                    item.textContent = "Highlight";
                });
            return;
        }
        clearHighlights();
        try {
            if (!("highlights" in CSS) || typeof Highlight === "undefined") {
                showStatus(
                    "This browser does not support safe page highlighting.",
                    true
                );
                return;
            }
            const ranges = [];
            const target = candidate.name;
            const walker = document.createTreeWalker(
                document.body,
                NodeFilter.SHOW_TEXT,
                {
                    acceptNode(node) {
                        let parent = node.parentElement;
                        while (parent && parent !== document.body) {
                            if (
                                isExcluded(parent) ||
                                parent.closest("#" + PANEL_ID)
                            ) {
                                return NodeFilter.FILTER_REJECT;
                            }
                            parent = parent.parentElement;
                        }
                        return node.nodeValue.trim()
                            ? NodeFilter.FILTER_ACCEPT
                            : NodeFilter.FILTER_REJECT;
                    }
                }
            );
            let node;
            while ((node = walker.nextNode())) {
                const text = node.nodeValue;
                const regex = new RegExp(
                    `(^|[^\\p{L}\\p{N}])(${escapeRegex(target)})(?=$|[^\\p{L}\\p{N}])`,
                    "gu"
                );
                let match;
                while ((match = regex.exec(text)) !== null) {
                    const start = match.index + match[1].length;
                    const range = new Range();
                    range.setStart(node, start);
                    range.setEnd(node, start + match[2].length);
                    ranges.push(range);
                }
            }
            if (!ranges.length) {
                showStatus(
                    "No exact visible occurrences could be highlighted.",
                    true
                );
                return;
            }
            CSS.highlights.set(
                "fr-scanner-highlight",
                new Highlight(...ranges)
            );
            highlightStyle = document.createElement("style");
            highlightStyle.textContent =
                "::highlight(fr-scanner-highlight){" +
                "background:#ffeb3b;color:#111;" +
                "text-decoration:underline;text-decoration-color:#f80}";
            document.head.appendChild(highlightStyle);
            highlightedCandidateId = candidate.id;
            document
                .querySelectorAll("#fr-scanner-panel .fr-highlight")
                .forEach((item) => {
                    item.textContent = "Highlight";
                });
            button.textContent = "Unhighlight";
            ranges[0].startContainer.parentElement?.scrollIntoView({
                behavior: "smooth",
                block: "center"
            });
            showStatus(
                `Highlighted ${ranges.length} visible occurrence(s) of ${candidate.name}.`
            );
        } catch (_) {
            clearHighlights();
            showStatus(
                "Highlighting failed; the page was left unchanged.",
                true
            );
        }
    }
    function showStatus(message, isError = false) {
        const status = document.querySelector("#fr-status");
        if (!status) return;
        status.textContent = message;
        status.classList.toggle("error", isError);
    }
    function runScan() {
        clearHighlights();
        try {
            currentText = extractVisibleText();
            if (!currentText) {
                candidates = [];
                starts = [];
                renderRows();
                showStatus(
                    "No usable visible page text found. Try a page containing the story text.",
                    true
                );
                return;
            }
            const result = analyze(currentText);
            candidates = result.candidates;
            starts = [];
            for (const candidate of candidates) {
                candidate.edit =
                    settings.edits[candidate.normalized] ?? candidate.name;
            }
            renderRows();
            showStatus(
                `Scan complete: ${result.scanned} detected occurrence(s), ` +
                    `${result.tokenFrequency.size} distinct normalized token(s), ` +
                    `maximum token count ${result.maximumTokenCount}.`
            );
        } catch (error) {
            candidates = [];
            starts = [];
            renderRows();
            showStatus(
                `Scan failed safely: ${error?.message || "unknown error"}`,
                true
            );
        }
    }
    // ---------------------------------------------------------------------
    // Initialization
    // ---------------------------------------------------------------------
    function initialize() {
        if (typeof GM_registerMenuCommand === "function") {
            GM_registerMenuCommand("Toggle FR Scanner 2", () => {
                const panel = document.getElementById(PANEL_ID);
                if (panel) {
                    clearHighlights();
                    panel.remove();
                    return;
                }
                createPanel();
                runScan();
            });
        } else {
            console.error(
                "FR Scanner: GM_registerMenuCommand is unavailable. " +
                    "Check userscript-manager permissions."
            );
        }
    }
    if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", initialize, {
            once: true
        });
    } else {
        initialize();
    }
