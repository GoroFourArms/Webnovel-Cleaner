    function createPanel() {
        if (document.getElementById(PANEL_ID)) return;
        ensureStyle();
        const panel = document.createElement("section");
        panel.id = PANEL_ID;
        panel.innerHTML = `
        <div class="fr-head">
            <span style="flex:1">FR Scanner 2</span>
            <button id="fr-scan" type="button">Rescan</button>
            <button id="fr-minimize" type="button">
                ${settings.minimized ? "Restore" : "Minimize"}
            </button>
            <button id="fr-close" type="button" title="Close panel">×</button>
        </div>
        <div class="fr-toolbar" id="fr-toolbar">
            <label>
                Template
                <select id="fr-template"></select>
            </label>
            <button id="fr-copy" type="button">Copy</button>
        </div>
        <div class="fr-tablewrap" id="fr-tablewrap">
            <table id="fr-table">
                <thead>
                    <tr>
                        <th data-col="highlight">Hi</th>
                        <th data-col="name">Name</th>
                        <th data-col="counts">Counts</th>
                        <th data-col="regex">Regex</th>
                        <th data-col="actions">Actions</th>
                    </tr>
                </thead>
                <tbody id="fr-rows"></tbody>
            </table>
        </div>
        <div class="fr-resize" title="Resize panel"></div>
    `;
        document.body.appendChild(panel);
        panel.style.left = `${Math.max(0, settings.x)}px`;
        panel.style.top = `${Math.max(0, settings.y)}px`;
        panel.style.width = `${Math.max(520, settings.width)}px`;
        panel.style.height = `${Math.max(260, settings.height)}px`;
        const templateSelect = panel.querySelector("#fr-template");
        for (const template of TEMPLATES) {
            const option = document.createElement("option");
            option.value = template;
            option.textContent = template;
            templateSelect.appendChild(option);
        }
        templateSelect.value = TEMPLATES.includes(settings.template)
            ? settings.template
            : "Other";
        settings.template = templateSelect.value;
        panel.querySelectorAll("th[data-col]").forEach((header) => {
            const handle = document.createElement("span");
            handle.className = "fr-colresize";
            handle.addEventListener("pointerdown", (event) => {
                startColumnResize(event, header.dataset.col, header);
            });
            header.appendChild(handle);
        });
        panel.querySelector("#fr-minimize").addEventListener("click", () => {
            settings.minimized = !settings.minimized;
            saveSettings();
            applyMinimized();
        });
        panel.querySelector("#fr-close").addEventListener("click", () => {
            clearHighlights();
            panel.remove();
        });
        panel.querySelector("#fr-scan").addEventListener("click", runScan);
        panel.querySelector("#fr-copy").addEventListener("click", () => {
            const text = visibleCandidates()
                .map((candidate) =>
                    generateRegex(
                        candidate.edit ?? candidate.name,
                        settings.template
                    )
                )
                .filter(Boolean)
                .join("\n");
            copyText(text);
        });
        templateSelect.addEventListener("change", () => {
            settings.template = templateSelect.value;
            saveSettings();
            renderRows();
        });
        panel
            .querySelector(".fr-head")
            .addEventListener("pointerdown", startDrag);
        panel
            .querySelector(".fr-resize")
            .addEventListener("pointerdown", startResize);
        applyMinimized();
        renderRows();
    }
    function applyMinimized() {
        const panel = document.getElementById(PANEL_ID);
        if (!panel) return;
        const minimized = Boolean(settings.minimized);
        panel
            .querySelector("#fr-toolbar")
            .classList.toggle("fr-hidden", minimized);
        panel
            .querySelector("#fr-tablewrap")
            .classList.toggle("fr-hidden", minimized);
        panel
            .querySelector(".fr-resize")
            .classList.toggle("fr-hidden", minimized);
        panel.style.height = minimized
            ? "38px"
            : `${Math.max(260, settings.height)}px`;
        panel.querySelector("#fr-minimize").textContent = minimized
            ? "Restore"
            : "Minimize";
    }
    function startDrag(event) {
        if (event.button !== 0) return;
        if (event.target.closest("button, input, select, textarea, a")) return;
        const panel = document.getElementById(PANEL_ID);
        if (!panel || settings.minimized) return;
        event.preventDefault();
        drag = {
            x: event.clientX,
            y: event.clientY,
            left: panel.offsetLeft,
            top: panel.offsetTop
        };
        document.addEventListener("pointermove", moveDrag);
        document.addEventListener("pointerup", endDrag, { once: true });
    }
    function moveDrag(event) {
        if (!drag) return;
        const panel = document.getElementById(PANEL_ID);
        if (!panel) return;
        const maxLeft = Math.max(0, window.innerWidth - panel.offsetWidth);
        const maxTop = Math.max(0, window.innerHeight - panel.offsetHeight);
        panel.style.left = `${Math.min(
            maxLeft,
            Math.max(0, drag.left + event.clientX - drag.x)
        )}px`;
        panel.style.top = `${Math.min(
            maxTop,
            Math.max(0, drag.top + event.clientY - drag.y)
        )}px`;
    }
    function endDrag() {
        if (!drag) return;
        const panel = document.getElementById(PANEL_ID);
        if (panel) {
            settings.x = panel.offsetLeft;
            settings.y = panel.offsetTop;
            saveSettings();
        }
        drag = null;
        document.removeEventListener("pointermove", moveDrag);
    }
    function startResize(event) {
        if (event.button !== 0 || settings.minimized) return;
        const panel = document.getElementById(PANEL_ID);
        if (!panel) return;
        event.preventDefault();
        event.stopPropagation();
        resize = {
            x: event.clientX,
            y: event.clientY,
            w: panel.offsetWidth,
            h: panel.offsetHeight
        };
        document.addEventListener("pointermove", moveResize);
        document.addEventListener("pointerup", endResize, { once: true });
    }
    function moveResize(event) {
        if (!resize) return;
        const panel = document.getElementById(PANEL_ID);
        if (!panel) return;
        const maxWidth = Math.max(520, window.innerWidth - panel.offsetLeft);
        const maxHeight = Math.max(260, window.innerHeight - panel.offsetTop);
        panel.style.width = `${Math.min(
            maxWidth,
            Math.max(520, resize.w + event.clientX - resize.x)
        )}px`;
        panel.style.height = `${Math.min(
            maxHeight,
            Math.max(260, resize.h + event.clientY - resize.y)
        )}px`;
    }
    function endResize() {
        const panel = document.getElementById(PANEL_ID);
        if (panel && resize) {
            settings.width = panel.offsetWidth;
            settings.height = panel.offsetHeight;
            panel.querySelectorAll("th[data-col]").forEach((header) => {
                const column = header.dataset.col;
                const width = header.getBoundingClientRect().width;
                if (column && width > 0) {
                    settings.columnWidths[column] = Math.round(width);
                }
            });
            saveSettings();
        }
        resize = null;
        document.removeEventListener("pointermove", moveResize);
    }
    function applyColumnWidths() {
        const table = document.getElementById("fr-table");
        if (!table) return;
        for (const [column, width] of Object.entries(
            settings.columnWidths || {}
        )) {
            const cells = table.querySelectorAll(`[data-col="${column}"]`);
            cells.forEach((cell) => {
                cell.style.width = `${Math.max(50, Math.min(400, width))}px`;
                cell.style.minWidth = "0";
                cell.style.maxWidth = "400px";
            });
        }
    }
    function startColumnResize(event, key, header) {
        event.preventDefault();
        event.stopPropagation();
        columnResize = {
            key,
            startX: event.clientX,
            startWidth: header.getBoundingClientRect().width
        };
        document.addEventListener("pointermove", moveColumnResize);
        document.addEventListener("pointerup", endColumnResize, { once: true });
    }
    function moveColumnResize(event) {
        if (!columnResize) return;
        const panel = document.getElementById(PANEL_ID);
        if (!panel) return;
        const header = panel.querySelector(
            `th[data-col="${columnResize.key}"]`
        );
        if (!header) return;
        const width = Math.max(
            50,
            Math.min(
                400,
                columnResize.startWidth + event.clientX - columnResize.startX
            )
        );
        header.style.width = `${width}px`;
    }
    function endColumnResize() {
        const panel = document.getElementById(PANEL_ID);
        if (panel && columnResize) {
            const header = panel.querySelector(
                `th[data-col="${columnResize.key}"]`
            );
            if (header) {
                settings.columnWidths ??= {};
                settings.columnWidths[columnResize.key] = Math.round(
                    header.getBoundingClientRect().width
                );
                saveSettings();
            }
        }
        columnResize = null;
        document.removeEventListener("pointermove", moveColumnResize);
    }
    function visibleCandidates() {
        return candidates;
    }
    function renderRows() {
        const panel = document.getElementById(PANEL_ID);
        if (!panel) return;
        const tbody = panel.querySelector("#fr-rows");
        if (!tbody) return;
        const shown = visibleCandidates();
        tbody.innerHTML = shown
            .map((candidate) => {
                const edit = candidate.edit ?? candidate.name ?? "";
                const regex = generateRegex(edit, settings.template);
                return `
                <tr data-id="${esc(candidate.id)}">
                    <td data-col="highlight">
                        <button type="button" class="fr-highlight">
                            Highlight
                        </button>
                    </td>
                    <td data-col="name">
                        <input
                            class="fr-edit"
                            aria-label="Edit candidate"
                            value="${esc(edit)}"
                        >
                    </td>
                    <td data-col="counts">
                        ${esc(candidate.countDisplay ?? "")}
                    </td>
                    <td data-col="regex">
                        <div class="fr-regex">${esc(regex)}</div>
                    </td>
                    <td data-col="actions">
                        <button type="button" class="fr-copy">
                            Copy regex
                        </button>
                    </td>
                </tr>
            `;
            })
            .join("");
        applyColumnWidths();
        // Keep the existing row event-listener code below this point.
    }
    async function copyText(text) {
        if (!text) {
            showStatus("Nothing to copy.", true);
            return;
        }
        try {
            if (typeof GM_setClipboard === "function") {
                GM_setClipboard(text, "text");
            } else if (navigator.clipboard?.writeText) {
                await navigator.clipboard.writeText(text);
            } else {
                const textarea = document.createElement("textarea");
                textarea.value = text;
                textarea.style.position = "fixed";
                textarea.style.opacity = "0";
                document.body.appendChild(textarea);
                textarea.select();
                const success = document.execCommand("copy");
                textarea.remove();
                if (!success) throw new Error("Copy command failed");
            }
            showStatus("Copied regex text.");
        } catch (_) {
            showStatus(
                "Could not copy. Check browser clipboard permissions.",
                true
            );
        }
    }
    function clearHighlights() {
        try {
            if ("highlights" in CSS) {
                CSS.highlights.delete("fr-scanner-highlight");
            }
        } catch (_) {}
        highlightStyle?.remove();
        highlightStyle = null;
        highlightedCandidateId = null;
    }
    function toggleHighlight(candidate, button) {
        if (highlightedCandidateId === candidate.id) {
            clearHighlights();
            document
                .querySelectorAll("#fr-scanner-panel .fr-highlight")
                .forEach((item) => {
                    item.textContent = "Highlight";
                });
            return;
        }
        clearHighlights();
        try {
            if (!("highlights" in CSS) || typeof Highlight === "undefined") {
                showStatus(
                    "This browser does not support safe page highlighting.",
                    true
                );
                return;
            }
            const ranges = [];
            const target = candidate.name;
            const walker = document.createTreeWalker(
                document.body,
                NodeFilter.SHOW_TEXT,
                {
                    acceptNode(node) {
                        let parent = node.parentElement;
                        while (parent && parent !== document.body) {
                            if (
                                isExcluded(parent) ||
                                parent.closest("#" + PANEL_ID)
                            ) {
                                return NodeFilter.FILTER_REJECT;
                            }
                            parent = parent.parentElement;
                        }
                        return node.nodeValue.trim()
                            ? NodeFilter.FILTER_ACCEPT
                            : NodeFilter.FILTER_REJECT;
                    }
                }
            );
            let node;
            while ((node = walker.nextNode())) {
                const text = node.nodeValue;
                const regex = new RegExp(
                    `(^|[^\\\p{L}\\\p{N}])(${escapeRegex(target)})(?=$|[^\\\p{L}\\\p{N}])`,
                    "gu"
                );
                let match;
                while ((match = regex.exec(text)) !== null) {
                    const start = match.index + match[1].length;
                    const range = new Range();
                    range.setStart(node, start);
                    range.setEnd(node, start + match[2].length);
                    ranges.push(range);
                }
            }
            if (!ranges.length) {
                showStatus(
                    "No exact visible occurrences could be highlighted.",
                    true
                );
                return;
            }
            CSS.highlights.set(
                "fr-scanner-highlight",
                new Highlight(...ranges)
            );
            highlightStyle = document.createElement("style");
            highlightStyle.textContent =
                "::highlight(fr-scanner-highlight){" +
                "background:#ffeb3b;color:#111;" +
                "text-decoration:underline;text-decoration-color:#f80}";
            document.head.appendChild(highlightStyle);
            highlightedCandidateId = candidate.id;
            document
                .querySelectorAll("#fr-scanner-panel .fr-highlight")
                .forEach((item) => {
                    item.textContent = "Highlight";
                });
            button.textContent = "Unhighlight";
            ranges[0].startContainer.parentElement?.scrollIntoView({
                behavior: "smooth",
                block: "center"
            });
            showStatus(
                `Highlighted ${ranges.length} visible occurrence(s) of ${candidate.name}.`
            );
        } catch (_) {
            clearHighlights();
            showStatus(
                "Highlighting failed; the page was left unchanged.",
                true
            );
        }
    }
    function showStatus(message, isError = false) {
        const status = document.querySelector("#fr-status");
        if (!status) return;
        status.textContent = message;
        status.classList.toggle("error", isError);
    }
    function runScan() {
        clearHighlights();
        try {
            currentText = extractVisibleText();
            if (!currentText) {
                candidates = [];
                renderRows();
                showStatus(
                    "No usable visible page text found. Try a page containing the story text.",
                    true
                );
                return;
            }
            const result = analyze(currentText);
            candidates = result.candidates;
            for (const candidate of candidates) {
                candidate.edit =
                    settings.edits[candidate.normalized] ?? candidate.name;
            }
            renderRows();
        } catch (error) {
            candidates = [];
            renderRows();
            showStatus(
                `Scan failed safely: ${error?.message || "unknown error"}`,
                true
            );
        }
    }
    function initialize() {
        if (typeof GM_registerMenuCommand === "function") {
            GM_registerMenuCommand("Toggle FR Scanner 2", () => {
                const panel = document.getElementById(PANEL_ID);
                if (panel) {
                    clearHighlights();
                    panel.remove();
                    return;
                }
                createPanel();
                runScan();
            });
        } else {
            console.error(
                "FR Scanner: GM_registerMenuCommand is unavailable. " +
                    "Check userscript-manager permissions."
            );
        }
    }
    if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", initialize, {
            once: true
        });
    } else {
        initialize();
    }
})();
