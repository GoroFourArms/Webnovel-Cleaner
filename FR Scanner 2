// ==UserScript==
// @name         FR Scanner 2
// @namespace    fr-scanner
// @version      3.0.1
// @description  FR Scanner 2 v3: scan visible text, normalize names, rank token counts, and prepare template-specific regexes.
// @match        *://*/*
// @grant        GM_getValue
// @grant        GM_setValue
// @grant        GM_setClipboard
// @grant        GM_registerMenuCommand
// @updateURL    https://github.com/GoroFourArms/Webnovel-Cleaner/raw/refs/heads/main/FR%20Scanner
// @downloadURL  https://github.com/GoroFourArms/Webnovel-Cleaner/raw/refs/heads/main/FR%20Scanner
// @run-at       document-idle
// ==/UserScript==
(() => {
    "use strict";
    const STORE_KEY = "frScanner.settings.v3";
    const PANEL_ID = "fr-scanner-panel";
    const EXCLUDED_TAGS = new Set([
        "SCRIPT",
        "STYLE",
        "NOSCRIPT",
        "TEMPLATE",
        "SVG",
        "CANVAS",
        "IFRAME",
        "NAV",
        "FOOTER",
        "HEADER",
        "ASIDE",
        "BUTTON",
        "INPUT",
        "TEXTAREA",
        "SELECT",
        "OPTION"
    ]);
    const BLOCK_TAGS = new Set([
        "ADDRESS",
        "ARTICLE",
        "BLOCKQUOTE",
        "BR",
        "DD",
        "DIV",
        "DL",
        "DT",
        "FIGCAPTION",
        "FIGURE",
        "H1",
        "H2",
        "H3",
        "H4",
        "H5",
        "H6",
        "LI",
        "MAIN",
        "P",
        "PRE",
        "SECTION",
        "TD",
        "TH",
        "TR"
    ]);
    const TEMPLATES = ["Other", "Korean", "Korean 2", "Japanese"];
    const DEFAULTS = {
        x: 20,
        y: 20,
        width: 700,
        height: 500,
        minimized: false,
        template: "Other",
        singletonCutoff: 0.05,
        showHiddenSingletons: false,
        edits: {},
        columnWidths: {}
    };
    // Exact, case-sensitive matches. Edit in code; no UI editor.
    const WORD_FILTER = new Set([
        // "Example",
    ]);
    // Capitalized common words to filter. Maintained manually.
    const HIGH_FREQUENCY_CAPITAL_WORDS = new Set([
        // "The",
        // "This",
    ]);
    const COMMON_CAPITALIZED_WORDS = new Set(
        (
            "a an the this that these those another any each every either " +
            "neither some several many much few all both other such same " +
            "he she it they we i you me him her them us my your his its " +
            "our their mine yours hers ours theirs who whom whose what " +
            "which when where why how if then than else however therefore " +
            "thus meanwhile instead still already just also only even " +
            "although though while because since unless until before after " +
            "once whenever wherever whether and but or nor so yet for " +
            "as at by from in into of off on onto out over under with " +
            "within without through during about against among between " +
            "around toward towards upon is am are was were be being been " +
            "do does did done have has had having can could may might " +
            "must shall should will would not no yes very too more most " +
            "less least here there now today tomorrow yesterday again " +
            "first second next last finally suddenly eventually perhaps " +
            "maybe well okay ok please thanks thank sorry hello goodbye"
        ).split(/\s+/)
    );
    const TITLE_PATTERN =
        /^(?:Mr|Mrs|Ms|Miss|Dr|Prof|Sr|Jr|St|Rev|Hon|Capt|Col|Gen|Sgt|Lt|Maj)\.$/i;
    const TOKEN_SOURCE =
        "(?:[A-Z](?:\\.[A-Z])+\\.?|[A-Z]\\.|[A-Z]{2,}|[A-Z][A-Za-z0-9'’\-]*)";
    const OCCURRENCE_RE = new RegExp(
        `\\b${TOKEN_SOURCE}(?:\\s+${TOKEN_SOURCE})*\\b`,
        "g"
    );
    const TEXT_CONTAINER_SELECTOR = "";
    let settings = loadSettings();
    let currentText = "";
    let candidates = [];
    let highlightStyle = null;
    let highlightedCandidateId = null;
    function loadSettings() {
        try {
            const saved =
                typeof GM_getValue === "function"
                    ? GM_getValue(STORE_KEY, {})
                    : {};
            const parsed = saved && typeof saved === "object" ? saved : {};
            const merged = {
                ...DEFAULTS,
                ...parsed,
                edits: { ...(parsed.edits || {}) },
                columnWidths: { ...(parsed.columnWidths || {}) }
            };
            for (const key of ["x", "y", "width", "height"]) {
                const value = Number(merged[key]);
                merged[key] = Number.isFinite(value) ? value : DEFAULTS[key];
            }
            merged.singletonCutoff = Number(merged.singletonCutoff);
            if (
                !Number.isFinite(merged.singletonCutoff) ||
                merged.singletonCutoff < 0 ||
                merged.singletonCutoff > 1
            ) {
                merged.singletonCutoff = DEFAULTS.singletonCutoff;
            }
            merged.minimized = Boolean(merged.minimized);
            if (!TEMPLATES.includes(merged.template)) {
                merged.template = "Other";
            }
            // Discard legacy UI-managed filters.
            delete merged.wordFilters;
            return merged;
        } catch (_) {
            return {
                ...DEFAULTS,
                edits: {},
                columnWidths: {}
            };
        }
    }
    function saveSettings() {
        try {
            if (typeof GM_setValue === "function") {
                GM_setValue(STORE_KEY, settings);
            }
        } catch (_) {}
    }
    function normalizeSpace(value) {
        return String(value ?? "")
            .normalize("NFKC")
            .replace(/[\u2018\u2019]/g, "'")
            .replace(/[\u201C\u201D]/g, '"')
            .replace(/[\u2013\u2014\u2212]/g, "-")
            .replace(/\s+/g, " ")
            .trim();
    }
    function normalizeToken(value) {
        let token = normalizeSpace(value).replace(
            /^[\s"'“”‘’([{]+|[\s"'“”‘’)}\\]]+$/g,
            ""
        );
        if (!token) return "";
        // Normalize case for phrase identity and comparison.
        token = token.toLowerCase();
        // Possessives:
        // smith's -> smith
        // smiths' -> smiths
        token = token.replace(/['’]s$/, "");
        token = token.replace(/s['’]$/, "s");
        // Conservative plural normalization.
        // This is for phrase matching, not full linguistic lemmatization.
        if (token.length > 4 && /ies$/.test(token)) {
            // stories -> story
            token = token.slice(0, -3) + "y";
        } else if (token.length > 4 && /(ches|shes|xes|zes)$/.test(token)) {
            // churches -> church; boxes -> box
            token = token.slice(0, -2);
        } else if (
            token.length > 4 &&
            /ses$/.test(token) &&
            !/sses$/.test(token)
        ) {
            // Conservative handling for selected -ses plurals.
            token = token.slice(0, -2);
        } else if (
            token.length > 3 &&
            /s$/.test(token) &&
            !/(ss|us|is)$/.test(token)
        ) {
            // cats -> cat; retain endings such as -ss, -us, and -is.
            token = token.slice(0, -1);
        }
        return token;
    }
    function tokens(value) {
        return normalizeSpace(value)
            .split(/\s+/)
            .filter(Boolean)
            .map((token) =>
                token.replace(/^[\s"'“”‘’([{]+|[\s"'“”‘’)}\\],.!?:;]+$/g, "")
            )
            .filter(Boolean);
    }
    function isCommonCapitalizedWord(rawToken) {
        const clean = normalizeSpace(rawToken).replace(/[.,:;!?]+$/g, "");
        if (TITLE_PATTERN.test(clean)) return false;
        const normalized = normalizeToken(clean);
        return COMMON_CAPITALIZED_WORDS.has(normalized);
    }
    function meaningfulTokens(phrase) {
        return tokens(phrase)
            .filter((token) => {
                // Exact, case-sensitive filtering.
                if (WORD_FILTER.has(token)) return false;
                if (HIGH_FREQUENCY_CAPITAL_WORDS.has(token)) return false;
                // Preserve the existing common-capitalized-word rule.
                if (isCommonCapitalizedWord(token)) return false;
                return true;
            })
            .map(normalizeToken)
            .filter(Boolean);
    }
    function escapeRegex(value) {
        return String(value).replace(/[.*+?^${}()|[\\]\\\\]/g, "\\\\$&");
    }
    function esc(value) {
        return String(value ?? "").replace(
            /[&<>"']/g,
            (char) =>
                ({
                    "&": "&amp;",
                    "<": "&lt;",
                    ">": "&gt;",
                    '"': "&quot;",
                    "'": "&#39;"
                })[char]
        );
    }
    function isExcluded(element) {
        if (!element || element.nodeType !== 1) return false;
        if (EXCLUDED_TAGS.has(element.tagName)) return true;
        if (element.hidden || element.getAttribute("aria-hidden") === "true") {
            return true;
        }
        const style = getComputedStyle(element);
        if (
            style.display === "none" ||
            style.visibility === "hidden" ||
            style.visibility === "collapse" ||
            style.opacity === "0"
        ) {
            return true;
        }
        const role = (element.getAttribute("role") || "").toLowerCase();
        const classText = `${element.id || ""} ${
            typeof element.className === "string" ? element.className : ""
        }`.toLowerCase();
        if (
            [
                "navigation",
                "complementary",
                "banner",
                "contentinfo",
                "dialog",
                "alertdialog"
            ].includes(role)
        ) {
            return true;
        }
        if (
            /(^|\b)(advert|advertisement|ad-container|popup|modal|comment|comments|recommend|related-post|chapter-list|pagination|pager|table-of-contents|toc)(\b|[-\_])/i.test(
                classText
            )
        ) {
            return true;
        }
        return false;
    }
    function extractVisibleText() {
        const page = document.body || document.documentElement;
        if (!page) return "";
        const MIN_TEXT_LENGTH = 300;
        function isUsable(element) {
            if (!element || element.closest("#" + PANEL_ID)) return false;
            if (isExcluded(element)) return false;
            if (!element.getClientRects().length) return false;
            const style = getComputedStyle(element);
            return (
                style.display !== "none" &&
                style.visibility !== "hidden" &&
                style.visibility !== "collapse" &&
                style.opacity !== "0"
            );
        }
        let selectedContainer = null;
        if (TEXT_CONTAINER_SELECTOR.trim()) {
            try {
                selectedContainer = page.querySelector(TEXT_CONTAINER_SELECTOR);
            } catch (error) {
                console.warn(
                    "FR Scanner: Invalid text container selector:",
                    TEXT_CONTAINER_SELECTOR,
                    error
                );
            }
        }
        if (TEXT_CONTAINER_SELECTOR.trim() && !selectedContainer) {
            console.warn(
                "FR Scanner: Text container not found:",
                TEXT_CONTAINER_SELECTOR
            );
            return "";
        }
        const blocks = (
            selectedContainer
                ? [
                      selectedContainer,
                      ...selectedContainer.querySelectorAll(
                          "article, main, section, div, address, p"
                      )
                  ]
                : [
                      ...page.querySelectorAll(
                          "article, main, section, div, address, p"
                      )
                  ]
        ).filter(isUsable);
        function textLength(element) {
            const walker = document.createTreeWalker(
                element,
                NodeFilter.SHOW_TEXT,
                {
                    acceptNode(node) {
                        const parent = node.parentElement;
                        if (!node.nodeValue?.trim() || !parent) {
                            return NodeFilter.FILTER_REJECT;
                        }
                        let current = parent;
                        while (current && current !== element) {
                            if (
                                isExcluded(current) ||
                                current.closest("#" + PANEL_ID)
                            ) {
                                return NodeFilter.FILTER_REJECT;
                            }
                            current = current.parentElement;
                        }
                        return NodeFilter.FILTER_ACCEPT;
                    }
                }
            );
            let total = 0;
            let node;
            while ((node = walker.nextNode())) {
                total += node.nodeValue.trim().length;
            }
            return total;
        }
        const ranked = blocks
            .map((element) => ({
                element,
                length: textLength(element)
            }))
            .filter((item) => item.length >= MIN_TEXT_LENGTH)
            .sort((a, b) => b.length - a.length);
        if (!ranked.length) return "";
        const root =
            ranked.find(
                ({ element }) =>
                    element !== document.body &&
                    element !== document.documentElement
            )?.element || page;
        if (!root) return "";
        const pieces = [];
        const walker = document.createTreeWalker(root, NodeFilter.SHOW_TEXT, {
            acceptNode(node) {
                const element = node.parentElement;
                if (!node.nodeValue?.trim() || !element || !isUsable(element)) {
                    return NodeFilter.FILTER_REJECT;
                }
                let current = element;
                while (current && current !== root) {
                    if (
                        isExcluded(current) ||
                        current.closest("#" + PANEL_ID)
                    ) {
                        return NodeFilter.FILTER_REJECT;
                    }
                    current = current.parentElement;
                }
                return NodeFilter.FILTER_ACCEPT;
            }
        });
        let node;
        while ((node = walker.nextNode())) {
            const text = node.nodeValue
                .replace(/[\u200B-\u200D\uFEFF\u00AD]/g, " ")
                .replace(/\s+/g, " ")
                .trim();
            if (!text) continue;
            const parentBlock = node.parentElement?.closest(
                [...BLOCK_TAGS].join(",")
            );
            pieces.push({
                text,
                block: parentBlock
            });
        }
        let result = "";
        let previousBlock = null;
        for (const piece of pieces) {
            if (result) {
                result +=
                    piece.block && piece.block !== previousBlock ? "\n" : " ";
            }
            result += piece.text;
            previousBlock = piece.block;
        }
        return result.trim();
    }
    function findOccurrenceSpans(text) {
        const occurrences = [];
        OCCURRENCE_RE.lastIndex = 0;
        let match;
        while ((match = OCCURRENCE_RE.exec(text)) !== null) {
            const phrase = match[0];
            const normalizedTokens = meaningfulTokens(phrase);
            // Discard occurrences whose tokens were all filtered.
            if (normalizedTokens.length === 0) {
                continue;
            }
            occurrences.push({
                text: tokens(phrase)
                    .filter((rawToken) =>
                        WORD_FILTER.has(rawToken) ||
                        HIGH_FREQUENCY_CAPITAL_WORDS.has(rawToken) ||
                        isCommonCapitalizedWord(rawToken)
                            ? false
                            : true
                    )
                    .join(" "),
                originalText: phrase,
                start: match.index,
                end: match.index + phrase.length,
                normalized: normalizedTokens.join(" "),
                normalizedTokens
            });
        }
        return occurrences;
    }
    function tokenSetIsSubset(shortTokens, longTokens) {
        const longSet = new Set(longTokens);
        return [...new Set(shortTokens)].every((token) => longSet.has(token));
    }
    function compareCountVectors(a, b) {
        const maxA = Math.max(0, ...(a.tokenCounts || []));
        const maxB = Math.max(0, ...(b.tokenCounts || []));
        return maxB - maxA || (a.originalIndex ?? 0) - (b.originalIndex ?? 0);
    }
    function analyze(text) {
        const occurrences = findOccurrenceSpans(text);
        const tokenFrequency = new Map();
        const grouped = new Map();
        for (const occurrence of occurrences) {
            for (const token of occurrence.normalizedTokens) {
                tokenFrequency.set(token, (tokenFrequency.get(token) || 0) + 1);
            }
        }
        occurrences.forEach((occurrence, index) => {
            const key = occurrence.normalized;
            let candidate = grouped.get(key);
            if (!candidate) {
                candidate = {
                    id: `fr-${index}-${key}`,
                    name: occurrence.text,
                    normalized: key,
                    normalizedTokens: [...occurrence.normalizedTokens],
                    occurrences: [],
                    occurrenceCount: 0,
                    originalIndex: index,
                    tokenCounts: [],
                    countDisplay: "",
                    edit: undefined
                };
                grouped.set(key, candidate);
            }
            candidate.occurrences.push(occurrence);
            candidate.occurrenceCount++;
        });
        let list = [...grouped.values()];
        for (const candidate of list) {
            candidate.tokenCounts = candidate.normalizedTokens.map(
                (token) => tokenFrequency.get(token) || 0
            );
            candidate.countDisplay = candidate.tokenCounts.join(", ");
        }
        // Same tokens in a different order: keep the more frequent phrase.
        const reordered = new Map();
        for (const candidate of list) {
            const key = [...candidate.normalizedTokens].sort().join("\u001F");
            const existing = reordered.get(key);
            if (
                !existing ||
                candidate.occurrenceCount > existing.occurrenceCount
            ) {
                reordered.set(key, candidate);
            }
        }
        list = [...reordered.values()];
        // Remove phrases whose tokens are contained in a longer phrase.
        list = list.filter(
            (candidate) =>
                !list.some(
                    (other) =>
                        other !== candidate &&
                        other.normalizedTokens.length >
                            candidate.normalizedTokens.length &&
                        tokenSetIsSubset(
                            candidate.normalizedTokens,
                            other.normalizedTokens
                        )
                )
        );
        for (const candidate of list) {
            candidate.edit =
                settings.edits?.[candidate.normalized] ?? candidate.name;
        }
        list.sort(compareCountVectors);
        return {
            candidates: list,
            scanned: occurrences.length,
            tokenFrequency,
            maximumTokenCount: Math.max(0, ...tokenFrequency.values())
        };
    }
    function generateRegex(candidate, template) {
        const value = String(candidate ?? "").trim();
        if (!value) return "";
        const parts = value.split(/\s+/).filter(Boolean);
        const escape = (text) => escapeRegex(text);
        // Preserve the existing rule: names without hyphens use Other format.
        if (!value.includes("-")) {
            return `(?<![a-z])${escape(value)}(?![a-z])`;
        }
        if (template === "Korean") {
            const finalName = escape(parts[parts.length - 1]).replace(
                /-/g,
                "[ -]?"
            );
            if (parts.length === 1) {
                return `(?<![a-z])${finalName}(?![a-z])`;
            }
            if (parts.length === 2) {
                const previous = escape(parts[0]);
                return `(?<![a-z])(?:${previous})?${finalName}(?![a-z])`;
            }
            const title = parts.slice(0, -2).join(" ");
            const previous = parts[parts.length - 2];
            const fullName = escape(value);
            return (
                `(?<![a-z])(?:(?:${escape(title)} )?` +
                `(?:${escape(previous)})?${finalName}|${fullName})(?![a-z])`
            );
        }
        if (template === "Japanese") {
            const lastTwo = parts.slice(-2);
            if (lastTwo.length === 2) {
                const first = escape(lastTwo[0]);
                const second = escape(lastTwo[1]);
                return (
                    `(?<![a-z])(?:${first}\\\s+${second}|` +
                    `${second}\\\s+${first})(?![a-z])`
                );
            }
            return `(?<![a-z])${escape(value)}(?![a-z])`;
        }
        // Other and Korean 2 retain the original fallback format.
        return `(?<![a-z])${escape(value)}(?![a-z])`;
    }
    function createPanel() {
        const panel = document.createElement("div");
        panel.id = PANEL_ID;

        panel.innerHTML = `
        <div class="fr-head" id="fr-head">
            <strong>FR Scanner 2</strong>
            <button id="fr-rescan" type="button">Rescan</button>
            <button id="fr-minimize" type="button">Minimize</button>
            <button id="fr-close" type="button">Close</button>
        </div>

        <div class="fr-toolbar" id="fr-toolbar">
            <label>
                Template
                <select id="fr-template"></select>
            </label>
            <button id="fr-copy" type="button">Copy</button>
        </div>

        <div class="fr-status" id="fr-status">Ready.</div>

        <div class="fr-tablewrap" id="fr-tablewrap">
            <table id="fr-table">
                <thead>
                    <tr>
                        <th data-col="highlight">HL</th>
                        <th data-col="name">Name</th>
                        <th data-col="counts">Counts</th>
                        <th data-col="regex">Regex</th>
                        <th data-col="actions">Actions</th>
                    </tr>
                </thead>
                <tbody id="fr-tbody"></tbody>
            </table>
        </div>

        <div class="fr-resize"></div>
    `;

        document.body.appendChild(panel);

        const templateSelect = panel.querySelector("#fr-template");

        for (const template of TEMPLATES) {
            const option = document.createElement("option");
            option.value = template;
            option.textContent = template;
            templateSelect.appendChild(option);
        }

        templateSelect.value = settings.template;

        templateSelect.addEventListener("change", () => {
            settings.template = templateSelect.value;
            saveSettings();
            renderRows();
        });

        panel.querySelector("#fr-rescan").addEventListener("click", scanPage);

        panel.querySelector("#fr-copy").addEventListener("click", async () => {
            const text = visibleCandidates()
                .map((candidate) =>
                    generateRegex(
                        candidate.edit ?? candidate.name,
                        settings.template
                    )
                )
                .filter(Boolean)
                .join("\n");

            if (!text) {
                showStatus("There are no regex results to copy.", true);
                return;
            }

            try {
                await navigator.clipboard.writeText(text);
                showStatus("Regex results copied.");
            } catch (error) {
                showStatus("Could not copy to clipboard.", true);
            }
        });

        panel.querySelector("#fr-minimize").addEventListener("click", () => {
            settings.minimized = !settings.minimized;
            applyMinimized();
            saveSettings();
        });

        panel.querySelector("#fr-close").addEventListener("click", () => {
            panel.remove();
        });

        makeDraggable(panel);
        makeResizable(panel);
        makeColumnsResizable(panel);
        applySettings(panel);
        renderRows();

        return panel;
    }
    function applyMinimized() {
        const panel = document.getElementById(PANEL_ID);
        if (!panel) return;
        const minimized = Boolean(settings.minimized);
        panel
            .querySelector("#fr-toolbar")
            .classList.toggle("fr-hidden", minimized);
        panel
            .querySelector("#fr-status")
            .classList.toggle("fr-hidden", minimized);
        panel
            .querySelector("#fr-tablewrap")
            .classList.toggle("fr-hidden", minimized);
        panel
            .querySelector(".fr-resize")
            .classList.toggle("fr-hidden", minimized);
        panel.style.height = minimized
            ? "38px"
            : `${Math.max(260, settings.height)}px`;
        panel.querySelector("#fr-minimize").textContent = minimized
            ? "Restore"
            : "Minimize";
    }
    function applyColumnWidths() {
        const table = document.getElementById("fr-table");
        if (!table) return;
        for (const [column, width] of Object.entries(
            settings.columnWidths || {}
        )) {
            const cells = table.querySelectorAll(`[data-col="${column}"]`);
            cells.forEach((cell) => {
                cell.style.width = `${Math.max(50, Math.min(400, width))}px`;
                cell.style.minWidth = "0";
                cell.style.maxWidth = "400px";
            });
        }
    }
    function visibleCandidates() {
        return candidates;
    }
    function renderRows() {
        const panel = document.getElementById(PANEL_ID);
        if (!panel) return;
        const tbody = panel.querySelector("#fr-rows");
        const countEl = panel.querySelector("#fr-count");
        if (!tbody || !countEl) return;
        const shown = visibleCandidates();
        const totalOccurrences = candidates.reduce(
            (total, candidate) => total + (candidate.occurrenceCount || 0),
            0
        );
        countEl.textContent =
            `${candidates.length} phrases · ${shown.length} shown · ` +
            `${totalOccurrences} occurrences`;
        tbody.innerHTML = shown
            .map((candidate) => {
                const edit = candidate.edit ?? candidate.name ?? "";
                const regex = generateRegex(edit, settings.template);
                return `
            <tr data-id="${esc(candidate.id)}">
                <td data-col="highlight">
                    <button type="button" class="fr-highlight">
                        Highlight
                    </button>
                </td>
                <td data-col="name">
                    <input
                        class="fr-edit"
                        aria-label="Edit candidate"
                        value="${esc(edit)}"
                    >
                </td>
                <td data-col="counts"
                    title="Token counts in original token order">
                    ${esc(candidate.countDisplay ?? "")}
                </td>
                <td data-col="regex">
                    <div class="fr-regex">${esc(regex)}</div>
                </td>
                <td data-col="actions">
                    <button type="button" class="fr-copy">
                        Copy regex
                    </button>
                </td>
            </tr>
        `;
            })
            .join("");
        applyColumnWidths();
        tbody.querySelectorAll("tr[data-id]").forEach((row) => {
            const candidate = shown.find(
                (item) => String(item.id) === row.dataset.id
            );
            if (!candidate) return;
            const editInput = row.querySelector(".fr-edit");
            const regexDisplay = row.querySelector(".fr-regex");
            const copyButton = row.querySelector(".fr-copy");
            const highlightButton = row.querySelector(".fr-highlight");
            editInput.addEventListener("input", (event) => {
                candidate.edit = event.target.value;
                settings.edits[candidate.normalized] = candidate.edit;
                saveSettings();
                regexDisplay.textContent = generateRegex(
                    candidate.edit,
                    settings.template
                );
            });
            copyButton.addEventListener("click", () => {
                copyText(
                    generateRegex(
                        candidate.edit ?? candidate.name ?? "",
                        settings.template
                    )
                );
            });
            highlightButton.addEventListener("click", () => {
                toggleHighlight(candidate, highlightButton);
            });
        });
    }
    async function copyText(text) {
        if (!text) {
            showStatus("Nothing to copy.", true);
            return;
        }
        try {
            if (typeof GM_setClipboard === "function") {
                GM_setClipboard(text, "text");
            } else if (navigator.clipboard?.writeText) {
                await navigator.clipboard.writeText(text);
            } else {
                const textarea = document.createElement("textarea");
                textarea.value = text;
                textarea.style.position = "fixed";
                textarea.style.opacity = "0";
                document.body.appendChild(textarea);
                textarea.select();
                const success = document.execCommand("copy");
                textarea.remove();
                if (!success) throw new Error("Copy command failed");
            }
            showStatus("Copied regex text.");
        } catch (_) {
            showStatus(
                "Could not copy. Check browser clipboard permissions.",
                true
            );
        }
    }
    function clearHighlights() {
        try {
            if ("highlights" in CSS) {
                CSS.highlights.delete("fr-scanner-highlight");
            }
        } catch (_) {}
        highlightStyle?.remove();
        highlightStyle = null;
        highlightedCandidateId = null;
    }
    function toggleHighlight(candidate, button) {
        if (highlightedCandidateId === candidate.id) {
            clearHighlights();
            document
                .querySelectorAll("#fr-scanner-panel .fr-highlight")
                .forEach((item) => {
                    item.textContent = "Highlight";
                });
            return;
        }
        clearHighlights();
        try {
            if (!("highlights" in CSS) || typeof Highlight === "undefined") {
                showStatus(
                    "This browser does not support safe page highlighting.",
                    true
                );
                return;
            }
            const ranges = [];
            const target = candidate.name;
            const walker = document.createTreeWalker(
                document.body,
                NodeFilter.SHOW_TEXT,
                {
                    acceptNode(node) {
                        let parent = node.parentElement;
                        while (parent && parent !== document.body) {
                            if (
                                isExcluded(parent) ||
                                parent.closest("#" + PANEL_ID)
                            ) {
                                return NodeFilter.FILTER_REJECT;
                            }
                            parent = parent.parentElement;
                        }
                        return node.nodeValue.trim()
                            ? NodeFilter.FILTER_ACCEPT
                            : NodeFilter.FILTER_REJECT;
                    }
                }
            );
            let node;
            while ((node = walker.nextNode())) {
                const text = node.nodeValue;
                const regex = new RegExp(
                    `(^|[^\\\p{L}\\\p{N}])(${escapeRegex(target)})(?=$|[^\\\p{L}\\\p{N}])`,
                    "gu"
                );
                let match;
                while ((match = regex.exec(text)) !== null) {
                    const start = match.index + match[1].length;
                    const range = new Range();
                    range.setStart(node, start);
                    range.setEnd(node, start + match[2].length);
                    ranges.push(range);
                }
            }
            if (!ranges.length) {
                showStatus(
                    "No exact visible occurrences could be highlighted.",
                    true
                );
                return;
            }
            CSS.highlights.set(
                "fr-scanner-highlight",
                new Highlight(...ranges)
            );
            highlightStyle = document.createElement("style");
            highlightStyle.textContent =
                "::highlight(fr-scanner-highlight){" +
                "background:#ffeb3b;color:#111;" +
                "text-decoration:underline;text-decoration-color:#f80}";
            document.head.appendChild(highlightStyle);
            highlightedCandidateId = candidate.id;
            document
                .querySelectorAll("#fr-scanner-panel .fr-highlight")
                .forEach((item) => {
                    item.textContent = "Highlight";
                });
            button.textContent = "Unhighlight";
            ranges[0].startContainer.parentElement?.scrollIntoView({
                behavior: "smooth",
                block: "center"
            });
            showStatus(
                `Highlighted ${ranges.length} visible occurrence(s) of ${candidate.name}.`
            );
        } catch (_) {
            clearHighlights();
            showStatus(
                "Highlighting failed; the page was left unchanged.",
                true
            );
        }
    }
    function showStatus(message, isError = false) {
        const status = document.querySelector("#fr-status");
        if (!status) return;
        status.textContent = message;
        status.classList.toggle("error", isError);
    }
    function runScan() {
        clearHighlights();
        try {
            currentText = extractVisibleText();
            if (!currentText) {
                candidates = [];
                renderRows();
                showStatus(
                    "No usable visible page text found. Try a page containing the story text.",
                    true
                );
                return;
            }
            const result = analyze(currentText);
            candidates = result.candidates;
            for (const candidate of candidates) {
                candidate.edit =
                    settings.edits[candidate.normalized] ?? candidate.name;
            }
            renderRows();
        } catch (error) {
            candidates = [];
            renderRows();
            showStatus(
                `Scan failed safely: ${error?.message || "unknown error"}`,
                true
            );
        }
    }
    function initialize() {
        if (typeof GM_registerMenuCommand === "function") {
            GM_registerMenuCommand("Toggle FR Scanner 2", () => {
                const panel = document.getElementById(PANEL_ID);
                if (panel) {
                    clearHighlights();
                    panel.remove();
                    return;
                }
                createPanel();
                runScan();
            });
        } else {
            console.error(
                "FR Scanner: GM_registerMenuCommand is unavailable. " +
                    "Check userscript-manager permissions."
            );
        }
    }
    if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", initialize, {
            once: true
        });
    } else {
        initialize();
    }
})();
