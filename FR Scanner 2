// ==UserScript==
// @name         FR Scanner 2
// @namespace    fr-scanner
// @version      2.0.0
// @description  Scan visible page text, count normalized name tokens, and prepare template-specific regexes.
// @match        *://*/*
// @grant        GM_getValue
// @grant        GM_setValue
// @grant        GM_setClipboard
// @grant        GM_registerMenuCommand
// @updateURL    https://github.com/GoroFourArms/Webnovel-Cleaner/raw/refs/heads/main/FR%20Scanner
// @downloadURL  https://github.com/GoroFourArms/Webnovel-Cleaner/raw/refs/heads/main/FR%20Scanner
// @run-at       document-idle
// ==/UserScript==
(() => {
    "use strict";
    const STORE_KEY = "frScanner.settings.v2";
    const PANEL_ID = "fr-scanner-panel";
    const STYLE_ID = "fr-scanner-style";
    const EXCLUDED_TAGS = new Set([
        "SCRIPT",
        "STYLE",
        "NOSCRIPT",
        "TEMPLATE",
        "SVG",
        "CANVAS",
        "IFRAME",
        "NAV",
        "FOOTER",
        "HEADER",
        "ASIDE",
        "BUTTON",
        "INPUT",
        "TEXTAREA",
        "SELECT",
        "OPTION"
    ]);
    const BLOCK_TAGS = new Set([
        "ADDRESS",
        "ARTICLE",
        "BLOCKQUOTE",
        "BR",
        "DD",
        "DIV",
        "DL",
        "DT",
        "FIGCAPTION",
        "FIGURE",
        "H1",
        "H2",
        "H3",
        "H4",
        "H5",
        "H6",
        "LI",
        "MAIN",
        "P",
        "PRE",
        "SECTION",
        "TD",
        "TH",
        "TR"
    ]);
    const TEMPLATES = ["Other", "Korean", "Korean 2", "Japanese"];
    const DEFAULTS = {
        x: 20,
        y: 20,
        width: 700,
        height: 500,
        minimized: false,
        template: "",
        singletonCutoff: 0.05,
        showHiddenSingletons: false,
        edits: {},
        columnWidths: {},
        wordFilters: {}
    };
    // These words are commonly capitalized because they occur at the
    // beginnings of sentences. Excluding them prevents many false positives.
    // Remove or add words here to customize the filter.
    const COMMON_CAPITALIZED_WORDS = new Set(
        (
            "a an the this that these those another any each every either " +
            "neither some several many much few all both other such same " +
            "he she it they we i you me him her them us my your his its " +
            "our their mine yours hers ours theirs who whom whose what " +
            "which when where why how if then than else however therefore " +
            "thus meanwhile instead still already just also only even " +
            "although though while because since unless until before after " +
            "once whenever wherever whether and but or nor so yet for " +
            "as at by from in into of off on onto out over under with " +
            "within without through during about against among between " +
            "around toward towards upon is am are was were be being been " +
            "do does did done have has had having can could may might " +
            "must shall should will would not no yes very too more most " +
            "less least here there now today tomorrow yesterday again " +
            "first second next last finally suddenly eventually perhaps " +
            "maybe well okay ok please thanks thank sorry hello goodbye"
        ).split(/\s+/)
    );
    const TITLE_PATTERN =
        /^(?:Mr|Mrs|Ms|Miss|Dr|Prof|Sr|Jr|St|Rev|Hon|Capt|Col|Gen|Sgt|Lt|Maj)\.$/i;
    const TOKEN_SOURCE =
        "(?:[A-Z](?:\\.[A-Z])+\\.?|[A-Z]\\.|[A-Z]{2,}|[A-Z][A-Za-z0-9'’\\-]*)";
    const OCCURRENCE_RE = new RegExp(
        `\\b${TOKEN_SOURCE}(?:\\s+${TOKEN_SOURCE})*\\b`,
        "g"
    );
    let settings = loadSettings();
    let currentText = "";
    let candidates = [];
    let starts = [];
    let highlightStyle = null;
    let highlightedCandidateId = null;
    let drag = null;
    let resize = null;
    let columnResize = null;
    function loadSettings() {
        let saved = {};
        try {
            const raw = localStorage.getItem(STORE_KEY);
            if (raw) {
                const parsed = JSON.parse(raw);
                if (
                    parsed &&
                    typeof parsed === "object" &&
                    !Array.isArray(parsed)
                ) {
                    saved = parsed;
                }
            }
        } catch (error) {
            console.warn("FR Scanner: Could not load saved settings.", error);
        }
        const defaults = JSON.parse(JSON.stringify(DEFAULTS));
        const merged = {
            ...defaults,
            ...saved,
            // Keep nested settings objects instead of replacing defaults entirely.
            edits: {
                ...defaults.edits,
                ...(saved.edits && typeof saved.edits === "object"
                    ? saved.edits
                    : {})
            },
            columnWidths: {
                ...defaults.columnWidths,
                ...(saved.columnWidths && typeof saved.columnWidths === "object"
                    ? saved.columnWidths
                    : {})
            },
            wordFilters: {
                ...defaults.wordFilters,
                ...(saved.wordFilters && typeof saved.wordFilters === "object"
                    ? saved.wordFilters
                    : {})
            }
        };
        // Validate numeric settings.
        const validNumber = (value, fallback, minimum, maximum) => {
            const number = Number(value);
            return Number.isFinite(number)
                ? Math.min(maximum, Math.max(minimum, number))
                : fallback;
        };
        merged.x = validNumber(merged.x, defaults.x, 0, 100000);
        merged.y = validNumber(merged.y, defaults.y, 0, 100000);
        merged.width = validNumber(merged.width, defaults.width, 420, 100000);
        merged.height = validNumber(
            merged.height,
            defaults.height,
            240,
            100000
        );
        merged.singletonCutoff = validNumber(
            merged.singletonCutoff,
            defaults.singletonCutoff,
            0,
            1
        );
        // Validate boolean settings.
        merged.minimized = Boolean(merged.minimized);
        merged.showHiddenSingletons = Boolean(merged.showHiddenSingletons);
        // Only accept known templates.
        if (!TEMPLATES.includes(merged.template)) {
            merged.template = defaults.template;
        }
        // Keep word-filter settings limited to supported values.
        for (const [word, mode] of Object.entries(merged.wordFilters)) {
            if (mode !== "Single Token" && mode !== "Anytime") {
                delete merged.wordFilters[word];
            }
        }
        return merged;
    }
    function saveSettings() {
        try {
            localStorage.setItem(STORE_KEY, JSON.stringify(settings));
            return true;
        } catch (error) {
            console.warn("FR Scanner: Could not save settings.", error);
            return false;
        }
    }
    function normalizeSpace(value) {
        return String(value ?? "")
            .normalize("NFKC")
            .replace(/[\u2018\u2019]/g, "'")
            .replace(/[\u201C\u201D]/g, '"')
            .replace(/[\u2013\u2014\u2212]/g, "-")
            .replace(/\s+/g, " ")
            .trim();
    }
    function normalizeToken(value) {
        let token = normalizeSpace(value)
            .toLowerCase()
            .replace(/^[\s"'“”‘’([{]+|[\s"'“”‘’)}\]]+$/g, "");
        if (!token) return "";
        // Possessives: Smith's -> smith; Smiths' -> smiths.
        token = token.replace(/['’]s$/i, "");
        token = token.replace(/s['’]$/, "s");
        // A deliberately conservative plural normalizer.
        // It is intended for counting, not linguistic lemmatization.
        if (token.length > 4 && /ies$/.test(token)) {
            token = token.slice(0, -3) + "y";
        } else if (token.length > 4 && /(ches|shes|xes|zes)$/.test(token)) {
            token = token.slice(0, -2);
        } else if (
            token.length > 4 &&
            /ses$/.test(token) &&
            !/sses$/.test(token)
        ) {
            token = token.slice(0, -2);
        } else if (
            token.length > 3 &&
            /s$/.test(token) &&
            !/(ss|us|is)$/.test(token)
        ) {
            token = token.slice(0, -1);
        }
        return token;
    }
    function tokens(value) {
        return normalizeSpace(value).split(/\s+/).filter(Boolean);
    }
    function isCommonCapitalizedWord(rawToken) {
        const clean = normalizeSpace(rawToken).replace(/[.,:;!?]+$/g, "");
        if (TITLE_PATTERN.test(clean)) return false;
        const normalized = normalizeToken(clean);
        return COMMON_CAPITALIZED_WORDS.has(normalized);
    }
    function meaningfulTokens(phrase) {
        const normalizedTokens = tokens(phrase);
        const filters = settings.wordFilters || {};
        return normalizedTokens.filter((token) => {
            // Keep the original token's casing for case-sensitive matching.
            for (const [filterText, mode] of Object.entries(filters)) {
                if (!filterText) continue;
                if (mode === "Single Token") {
                    // Remove a token only when it exactly matches the filter.
                    if (token === filterText) {
                        return false;
                    }
                } else if (mode === "Anytime") {
                    // Remove tokens containing the filter text, case-sensitively.
                    if (token.includes(filterText)) {
                        return false;
                    }
                }
            }
            return true;
        });
    }
    function identity(value) {
        return meaningfulTokens(value).join(" ");
    }
    function escapeRegex(value) {
        return String(value).replace(/[.*+?^${}()|[\]\\]/g, "\\$&");
    }
    function esc(value) {
        return String(value ?? "").replace(
            /[&<>"']/g,
            (char) =>
                ({
                    "&": "&amp;",
                    "<": "&lt;",
                    ">": "&gt;",
                    '"': "&quot;",
                    "'": "&#39;"
                })[char]
        );
    }
    // ---------------------------------------------------------------------
    // Visible page text extraction
    // ---------------------------------------------------------------------
    function isExcluded(element) {
        if (!element || element.nodeType !== 1) return false;
        if (EXCLUDED_TAGS.has(element.tagName)) return true;
        if (element.hidden || element.getAttribute("aria-hidden") === "true") {
            return true;
        }
        const style = getComputedStyle(element);
        if (
            style.display === "none" ||
            style.visibility === "hidden" ||
            style.visibility === "collapse" ||
            style.opacity === "0"
        ) {
            return true;
        }
        const role = (element.getAttribute("role") || "").toLowerCase();
        const classText = `${element.id || ""} ${
            typeof element.className === "string" ? element.className : ""
        }`.toLowerCase();
        if (
            [
                "navigation",
                "complementary",
                "banner",
                "contentinfo",
                "dialog",
                "alertdialog"
            ].includes(role)
        ) {
            return true;
        }
        if (
            /(^|\b)(advert|advertisement|ad-container|popup|modal|comment|comments|recommend|related-post|chapter-list|pagination|pager|table-of-contents|toc)(\b|[-_])/i.test(
                classText
            )
        ) {
            return true;
        }
        return false;
    }
    function extractVisibleText() {
        const page = document.body || document.documentElement;
        if (!page) return "";
        const MIN_TEXT_LENGTH = 300;
        function isUsable(element) {
            if (!element || element.closest("#" + PANEL_ID)) return false;
            if (isExcluded(element)) return false;
            if (!element.getClientRects().length) return false;
            const style = getComputedStyle(element);
            return (
                style.display !== "none" &&
                style.visibility !== "hidden" &&
                style.visibility !== "collapse" &&
                style.opacity !== "0"
            );
        }
        const blocks = [
            ...page.querySelectorAll("article, main, section, div")
        ].filter(isUsable);
        function textLength(element) {
            const walker = document.createTreeWalker(
                element,
                NodeFilter.SHOW_TEXT,
                {
                    acceptNode(node) {
                        const parent = node.parentElement;
                        if (!node.nodeValue?.trim() || !parent) {
                            return NodeFilter.FILTER_REJECT;
                        }
                        let current = parent;
                        while (current && current !== element) {
                            if (
                                isExcluded(current) ||
                                current.closest("#" + PANEL_ID)
                            ) {
                                return NodeFilter.FILTER_REJECT;
                            }
                            current = current.parentElement;
                        }
                        return NodeFilter.FILTER_ACCEPT;
                    }
                }
            );
            let total = 0;
            let node;
            while ((node = walker.nextNode())) {
                total += node.nodeValue.trim().length;
            }
            return total;
        }
        const ranked = blocks
            .map((element) => ({
                element,
                length: textLength(element)
            }))
            .filter((item) => item.length >= MIN_TEXT_LENGTH)
            .sort((a, b) => b.length - a.length);
        if (!ranked.length) return "";
        const root = ranked.find(
            ({ element }) =>
                element !== document.body &&
                element !== document.documentElement
        )?.element;
        if (!root) return "";
        const pieces = [];
        const walker = document.createTreeWalker(root, NodeFilter.SHOW_TEXT, {
            acceptNode(node) {
                const element = node.parentElement;
                if (!node.nodeValue?.trim() || !element || !isUsable(element)) {
                    return NodeFilter.FILTER_REJECT;
                }
                let current = element;
                while (current && current !== root) {
                    if (
                        isExcluded(current) ||
                        current.closest("#" + PANEL_ID)
                    ) {
                        return NodeFilter.FILTER_REJECT;
                    }
                    current = current.parentElement;
                }
                return NodeFilter.FILTER_ACCEPT;
            }
        });
        let node;
        while ((node = walker.nextNode())) {
            const text = node.nodeValue
                .replace(/[\u200B-\u200D\uFEFF\u00AD]/g, " ")
                .replace(/\s+/g, " ")
                .trim();
            if (!text) continue;
            const parentBlock = node.parentElement?.closest(
                [...BLOCK_TAGS].join(",")
            );
            pieces.push({
                text,
                block: parentBlock
            });
        }
        let result = "";
        let previousBlock = null;
        for (const piece of pieces) {
            if (result) {
                result +=
                    piece.block && piece.block !== previousBlock ? "\n" : " ";
            }
            result += piece.text;
            previousBlock = piece.block;
        }
        return result.trim();
    }
    // ---------------------------------------------------------------------
    // Occurrence detection
    // ---------------------------------------------------------------------
    function findOccurrenceSpans(text) {
        const occurrences = [];
        const regex = new RegExp(OCCURRENCE_RE.source, "g");
        let match;
        while ((match = regex.exec(text)) !== null) {
            const phrase = match[0];
            const rawTokens = tokens(phrase);
            const filters = settings.wordFilters || {};
            // Single Token: discard only a standalone matching occurrence.
            if (
                rawTokens.length === 1 &&
                filters[rawTokens[0]] === "Single Token"
            ) {
                continue;
            }
            // Anytime: remove matching complete tokens from the phrase.
            const retainedTokens = rawTokens.filter(
                (token) => filters[token] !== "Anytime"
            );
            if (!retainedTokens.length) continue;
            const normalizedTokens = meaningfulTokens(retainedTokens.join(" "));
            if (!normalizedTokens.length) continue;
            occurrences.push({
                text: phrase,
                start: match.index,
                end: match.index + phrase.length,
                normalized: normalizedTokens.join(" "),
                normalizedTokens
            });
        }
        return occurrences;
    }
    // ---------------------------------------------------------------------
    // Containment and token counts
    // ---------------------------------------------------------------------
    function isContiguousSubsequence(shortTokens, longTokens) {
        if (!shortTokens.length || shortTokens.length >= longTokens.length) {
            return false;
        }
        for (
            let start = 0;
            start <= longTokens.length - shortTokens.length;
            start++
        ) {
            let matches = true;
            for (let offset = 0; offset < shortTokens.length; offset++) {
                if (shortTokens[offset] !== longTokens[start + offset]) {
                    matches = false;
                    break;
                }
            }
            if (matches) return true;
        }
        return false;
    }
    function compareCountVectors(a, b) {
        const left = [...a.tokenCounts].sort((x, y) => y - x);
        const right = [...b.tokenCounts].sort((x, y) => y - x);
        const length = Math.max(left.length, right.length);
        for (let i = 0; i < length; i++) {
            const leftValue = left[i] ?? 0;
            const rightValue = right[i] ?? 0;
            if (leftValue !== rightValue) {
                return rightValue - leftValue;
            }
        }
        return a.originalIndex - b.originalIndex;
    }
    function analyze(text) {
        const occurrences = findOccurrenceSpans(text);
        // Count meaningful normalized tokens across all detected occurrences.
        // Repeated tokens within one occurrence count repeatedly.
        const tokenFrequency = new Map();
        for (const occurrence of occurrences) {
            for (const token of occurrence.normalizedTokens) {
                tokenFrequency.set(token, (tokenFrequency.get(token) || 0) + 1);
            }
        }
        // Group occurrences by normalized phrase identity.
        const grouped = new Map();
        for (const occurrence of occurrences) {
            const key = occurrence.normalized;
            // Ignore occurrences with no meaningful normalized identity.
            if (!key || !occurrence.normalizedTokens.length) continue;
            let item = grouped.get(key);
            if (!item) {
                item = {
                    id: `candidate-${grouped.size}-${key}`,
                    name: occurrence.text,
                    normalized: key,
                    normalizedTokens: [...occurrence.normalizedTokens],
                    occurrences: [],
                    occurrenceCount: 0,
                    originalIndex: occurrence.start,
                    tokenCounts: [],
                    countDisplay: "",
                    edit: settings.edits[key] ?? occurrence.text
                };
                grouped.set(key, item);
            }
            item.occurrences.push(occurrence);
            item.occurrenceCount++;
            // Prefer the shortest readable version for display.
            if (occurrence.text.length < item.name.length) {
                item.name = occurrence.text;
            }
            if (occurrence.start < item.originalIndex) {
                item.originalIndex = occurrence.start;
            }
        }
        const allCandidates = [...grouped.values()];
        // Remove a shorter candidate only when its complete meaningful token
        // sequence appears contiguously inside a candidate with more tokens.
        // A candidate with its own unique token is not removed by this rule.
        const list = allCandidates.filter((shorter) => {
            return !allCandidates.some((longer) => {
                if (shorter === longer) return false;
                if (
                    longer.normalizedTokens.length <=
                    shorter.normalizedTokens.length
                ) {
                    return false;
                }
                return isContiguousSubsequence(
                    shorter.normalizedTokens,
                    longer.normalizedTokens
                );
            });
        });
        // Calculate token counts using all detected occurrences, including
        // occurrences belonging to candidates removed by the containment rule.
        for (const candidate of list) {
            candidate.tokenCounts = candidate.normalizedTokens.map(
                (token) => tokenFrequency.get(token) || 0
            );
            candidate.countDisplay = candidate.tokenCounts.join(", ");
            candidate.frequency = Math.max(0, ...candidate.tokenCounts);
            candidate.prefixes = new Map();
            candidate.suffixes = new Map();
            candidate.clusterSeed = null;
        }
        // Determine the cutoff from the most frequent meaningful token.
        const maximumTokenCount = Math.max(0, ...tokenFrequency.values());
        const cutoff = maximumTokenCount * settings.singletonCutoff;
        // Keep all surviving candidates internally; visibility is controlled
        // separately by visibleCandidates().
        for (const candidate of list) {
            candidate.hiddenByCutoff =
                candidate.tokenCounts.length > 0 &&
                candidate.tokenCounts.every((count) => count <= cutoff);
        }
        list.sort(compareCountVectors);
        return {
            candidates: list,
            starts: [],
            scanned: occurrences.length,
            tokenFrequency,
            maximumTokenCount,
            cutoff
        };
    }
    function generateRegex(candidate, template) {
        const value = String(candidate ?? "").trim();
        if (!value) return "";
        const parts = value.split(/\s+/).filter(Boolean);
        const escape = (text) => escapeRegex(text);
        // Preserve the existing rule: names without hyphens use Other format.
        if (!value.includes("-")) {
            return `(?<![a-z])${escape(value)}(?![a-z])`;
        }
        if (template === "Korean") {
            const finalName = escape(parts[parts.length - 1]).replace(
                /-/g,
                "[ -]?"
            );
            if (parts.length === 1) {
                return `(?<![a-z])${finalName}(?![a-z])`;
            }
            if (parts.length === 2) {
                const previous = escape(parts[0]);
                return `(?<![a-z])(?:${previous})?${finalName}(?![a-z])`;
            }
            const title = parts.slice(0, -2).join(" ");
            const previous = parts[parts.length - 2];
            const fullName = escape(value);
            return (
                `(?<![a-z])(?:(?:${escape(title)} )?` +
                `(?:${escape(previous)})?${finalName}|${fullName})(?![a-z])`
            );
        }
        if (template === "Japanese") {
            const lastTwo = parts.slice(-2);
            if (lastTwo.length === 2) {
                const first = escape(lastTwo[0]);
                const second = escape(lastTwo[1]);
                return (
                    `(?<![a-z])(?:${first}\\s+${second}|` +
                    `${second}\\s+${first})(?![a-z])`
                );
            }
            return `(?<![a-z])${escape(value)}(?![a-z])`;
        }
        // Other and Korean 2 retain the original fallback format.
        return `(?<![a-z])${escape(value)}(?![a-z])`;
    }
    // ---------------------------------------------------------------------
    // Styling and panel creation
    // ---------------------------------------------------------------------
    function ensureStyle() {
        if (document.getElementById(STYLE_ID)) return;
        const style = document.createElement("style");
        style.id = STYLE_ID;
        style.textContent = `
            #${PANEL_ID} {
                position: fixed;
