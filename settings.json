"emeraldwalk.runonsave": {
    "commands": [
        {
            "match": "\\.(js|txt)$",
            "cmd": "powershell -NoProfile -Command \"$c = (Get-Content -Path '${file}') | Where-Object { $_.Trim() -ne '' }; [System.IO.File]::WriteAllLines('${file}', $c)\"",
            "isAsync": false
        }
    ]
}